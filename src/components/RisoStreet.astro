---
/**
 * The home page print (scripts/street.ts): one Boston street, printed eight
 * times as you scroll through the home section, each with a one-line caption
 * from data/story.ts. GSAP's ScrollTrigger turns the scroll into a position
 * along the plates, with a short smoothing lag.
 *
 * Screen readers get all eight captions as a list; the moving caption and the
 * canvas are hidden from them.
 */
import { STORY } from '../data/story';
---
<figure class="riso" data-riso>
  <div class="riso__plate"><canvas aria-hidden="true"></canvas></div>
  <figcaption class="riso__caption" aria-hidden="true">
    <span class="riso__kicker"><span data-riso-n>01</span>/{String(STORY.length).padStart(2, '0')} <span class="riso__term" data-riso-term>{STORY[0].term}</span></span>
    <span class="riso__line" data-riso-line>{STORY[0].line}</span>
  </figcaption>
  <div class="sr-only">
    <p>An illustration of a street in Boston, shown eight ways:</p>
    <ol>{STORY.map((s) => <li>{s.term}: {s.line}</li>)}</ol>
  </div>
</figure>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { mountStreet } from '../scripts/street';
  import { STORY } from '../data/story';

  gsap.registerPlugin(ScrollTrigger);

  const fig = document.querySelector<HTMLElement>('[data-riso]');
  const trigger = fig?.closest<HTMLElement>('[data-story]');

  if (fig && trigger) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    mountStreet(fig, reduce).then((view) => {
      const state = { pos: 0 };
      gsap.to(state, {
        // a little past the last plate, so it holds before the section ends
        pos: STORY.length - 0.6,
        ease: 'none',
        scrollTrigger: { trigger, start: 'top top', end: 'bottom bottom', scrub: reduce ? true : 0.6 },
        onUpdate: () => view.show(state.pos),
      });
    });
  }
</script>
