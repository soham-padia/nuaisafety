---
import { EXEC_URL, mailtoHref } from '../config';

interface Props {
  variant?: 'button' | 'inline';
  label?: string;
}

const { variant = 'button', label = 'Join the executive group' } = Astro.props;
const href = EXEC_URL ?? mailtoHref('Executive group') ?? '/join';
---
{variant === 'button' ? (
  <a class="btn" href={href}>{label} →</a>
) : (
  <a class="arrow" href={href}><span>{label}</span></a>
)}
