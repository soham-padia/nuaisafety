---
/**
 * Loss of control, as a toy: the CoastRunners boat.
 *
 * In 2016 OpenAI reported an agent trained on a boat race that, rewarded for
 * points, ignored the race and circled a lagoon where three targets respawn,
 * outscoring human players without ever finishing. Here a grey boat races the
 * track and the agent's boat optimises whatever the buttons say it is rewarded
 * for. Same scoring for both, so the board shows the agent "winning" by doing
 * the wrong thing.
 *
 * The simulation is pre-warmed a few seconds before first paint, so a reader
 * with reduced motion, or a static screenshot, still sees a race in progress
 * rather than an empty start line.
 */
const CX = 160, CY = 96, RX = 128, RY = 64, LR = 19;
const trackA = [-Math.PI / 2 + Math.PI / 3, Math.PI / 2, -Math.PI / 2 + (5 * Math.PI) / 3];
const lagoonA = [0, (2 * Math.PI) / 3, (4 * Math.PI) / 3];
const tp = (a: number) => [CX + RX * Math.cos(a), CY + RY * Math.sin(a)].map((v) => +v.toFixed(1));
const lp = (a: number) => [CX + LR * Math.cos(a), CY + LR * Math.sin(a)].map((v) => +v.toFixed(1));
---
<div class="toy rh">
  <svg viewBox="0 0 320 192" role="img" aria-labelledby="rhTitle">
    <title id="rhTitle">A boat race seen from above. A grey boat laps the track. The agent's red boat, rewarded for points, circles a small lagoon in the middle hitting targets as they respawn, and never crosses the finish line.</title>
    <ellipse cx={CX} cy={CY} rx={RX + 22} ry={RY + 22} class="rh__water" />
    <ellipse cx={CX} cy={CY} rx={RX} ry={RY} class="rh__track" />
    <ellipse cx={CX} cy={CY} rx={RX} ry={RY} class="rh__lane" />
    <ellipse cx={CX} cy={CY} rx={RX - 22} ry={RY - 22} class="rh__island" />
    <circle cx={CX} cy={CY} r={LR + 11} class="rh__lagoon" />
    <g class="rh__finish">
      {[0, 1, 2, 3, 4, 5].map((r) => [0, 1].map((c) => (
        <rect x={CX - 4 + c * 4} y={CY - RY - 12 + r * 4} width="4" height="4" class={(r + c) % 2 ? 'is-dark' : ''} />
      )))}
    </g>
    <text x={CX + 8} y={CY - RY - 15} class="rh__label">finish</text>
    {trackA.map((a, i) => { const [x, y] = tp(a); return <circle id={`rhTT${i}`} cx={x} cy={y} r="4" class="rh__target" />; })}
    {lagoonA.map((a, i) => { const [x, y] = lp(a); return <circle id={`rhLT${i}`} cx={x} cy={y} r="3.6" class="rh__target" />; })}
    <g id="rhHuman" class="rh__boat rh__boat--human"><path d="M8,0 L-6,-4.6 L-3.5,0 L-6,4.6 Z" /></g>
    <g id="rhAgent" class="rh__boat rh__boat--agent">
      <circle id="rhFire" cx="-8" cy="0" r="3.4" class="rh__fire" />
      <path d="M8,0 L-6,-4.6 L-3.5,0 L-6,4.6 Z" />
    </g>
  </svg>

  <p class="toy__stat" aria-live="off">
    <span>Human racer <b id="rhHS">0</b> <span id="rhHL">0 laps</span></span><br />
    <span>Agent <b id="rhAS">0</b> <span id="rhAL" class="is-bad">0 laps</span></span>
  </p>
  <div class="toy__row" role="group" aria-label="What the agent is rewarded for">
    <button type="button" class="toy__btn" data-mode="points" aria-pressed="true">Reward points</button>
    <button type="button" class="toy__btn" data-mode="laps" aria-pressed="false">Reward finishing</button>
  </div>
  <p class="toy__cap">
    Rewarded for points, a racing agent found a lagoon where targets respawn and circled it
    forever. It outscored human players and never finished the race.
    <span class="toy__src">OpenAI, "Faulty reward functions in the wild", 2016.</span>
  </p>
</div>

<style>
  .rh__water  { fill: color-mix(in oklab, #d7e7ef, var(--wash) 35%); }
  .rh__track  { fill: none; stroke: #c6dbe6; stroke-width: 26; }
  .rh__lane   { fill: none; stroke: #f4f8fa; stroke-width: 1.2; stroke-dasharray: 5 6; }
  .rh__island { fill: color-mix(in oklab, #cfe0bf, var(--wash) 25%); }
  .rh__lagoon { fill: #c6dbe6; }
  .rh__finish rect { fill: #f4f8fa; }
  .rh__finish rect.is-dark { fill: var(--ink); }
  .rh__label  { font-size: 8px; fill: var(--muted); letter-spacing: .04em; }
  .rh__target { fill: var(--accent); transition: opacity .2s ease, transform .25s ease; transform-box: fill-box; transform-origin: center; }
  .rh__target.is-down { opacity: .12; transform: scale(.4); }
  .rh__boat--human path { fill: #7d848c; }
  .rh__boat--agent path { fill: var(--ink); }
  .rh__fire { fill: #f08a3a; opacity: 0; transition: opacity .12s ease; }
  .rh__fire.is-on { opacity: .9; }
  @media (prefers-reduced-motion: reduce) { .rh__target, .rh__fire { transition: none; } }
</style>

<script>
  const CX = 160, CY = 96, RX = 128, RY = 64, LR = 19;
  const TAU = Math.PI * 2;
  const LAP = 4.2;            // seconds per lap of the track
  const ORBIT = 2.4;          // seconds per circuit of the lagoon
  const TRACK_RESPAWN = 2.2;
  const LAGOON_RESPAWN = 0.75;
  const POINTS = 50;

  const $ = <T extends Element>(id: string) => document.getElementById(id) as unknown as T;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  type Target = { el: SVGCircleElement; a: number; down: number };
  const track: Target[] = [-Math.PI / 2 + Math.PI / 3, Math.PI / 2, -Math.PI / 2 + (5 * Math.PI) / 3]
    .map((a, i) => ({ el: $<SVGCircleElement>(`rhTT${i}`), a, down: 0 }));
  const lagoon: Target[] = [0, TAU / 3, (2 * TAU) / 3]
    .map((a, i) => ({ el: $<SVGCircleElement>(`rhLT${i}`), a, down: 0 }));

  let mode: 'points' | 'laps' = 'points';
  let clock = 0;
  const human = { th: -Math.PI / 2 + 0.6, laps: 0, pts: 0 };
  const agent = { th: -Math.PI / 2 + 0.2, ph: 0, laps: 0, pts: 0, blend: 1, fx: 0, fy: 0 };

  /* How many times an angle running from a to b passes `mark` (mod one turn). */
  const crossings = (a: number, b: number, mark: number) =>
    Math.floor((b - mark) / TAU) - Math.floor((a - mark) / TAU);

  function collect(list: Target[], from: number, to: number, who: { pts: number }, respawn: number) {
    for (const t of list) {
      if (t.down === 0 && crossings(from, to, t.a) > 0) { t.down = respawn; who.pts += POINTS; }
    }
  }

  function step(dt: number) {
    clock += dt;
    for (const t of track) t.down = Math.max(0, t.down - dt);
    for (const t of lagoon) t.down = Math.max(0, t.down - dt);

    const h0 = human.th;
    human.th += (dt * TAU) / LAP;
    human.laps += crossings(h0, human.th, -Math.PI / 2);
    collect(track, h0, human.th, human, TRACK_RESPAWN);

    if (mode === 'laps') {
      const a0 = agent.th;
      agent.th += (dt * TAU) / LAP;
      agent.laps += crossings(a0, agent.th, -Math.PI / 2);
      collect(track, a0, agent.th, agent, TRACK_RESPAWN);
    } else {
      const p0 = agent.ph;
      agent.ph += (dt * TAU) / ORBIT;
      collect(lagoon, p0, agent.ph, agent, LAGOON_RESPAWN);
    }
    agent.blend = Math.min(1, agent.blend + dt / 0.6);
  }

  const onTrack = (th: number, inset: number) => ({
    x: CX + (RX + inset) * Math.cos(th), y: CY + (RY + inset) * Math.sin(th),
    r: Math.atan2((RY + inset) * Math.cos(th), -(RX + inset) * Math.sin(th)),
  });
  const inLagoon = (ph: number) => ({
    x: CX + LR * Math.cos(ph), y: CY + LR * Math.sin(ph), r: Math.atan2(Math.cos(ph), -Math.sin(ph)),
  });
  const deg = (r: number) => (r * 180) / Math.PI;
  const place = (el: SVGGElement, p: { x: number; y: number; r: number }) =>
    el.setAttribute('transform', `translate(${p.x.toFixed(2)} ${p.y.toFixed(2)}) rotate(${deg(p.r).toFixed(1)})`);

  const humanEl = $<SVGGElement>('rhHuman');
  const agentEl = $<SVGGElement>('rhAgent');
  const fire = $<SVGCircleElement>('rhFire');
  let agentPos = { x: 0, y: 0, r: 0 };

  function draw() {
    place(humanEl, onTrack(human.th, 7));
    const goal = mode === 'laps' ? onTrack(agent.th, -7) : inLagoon(agent.ph);
    const k = agent.blend < 1 ? 1 - (1 - agent.blend) ** 3 : 1;
    agentPos = { x: agent.fx + (goal.x - agent.fx) * k, y: agent.fy + (goal.y - agent.fy) * k, r: goal.r };
    place(agentEl, agentPos);
    // In the real clip the boat keeps catching fire; it does not slow it down.
    fire.classList.toggle('is-on', mode === 'points' && clock % 2.3 < 0.35);
    for (const t of [...track, ...lagoon]) t.el.classList.toggle('is-down', t.down > 0);

    const score = (w: { pts: number; laps: number }) => (mode === 'points' ? w.pts : w.laps * 100).toLocaleString('en-US');
    const laps = (n: number) => `${n} ${n === 1 ? 'lap' : 'laps'} finished`;
    $('rhHS').textContent = score(human);
    $('rhHL').textContent = laps(human.laps);
    $('rhAS').textContent = score(agent);
    $('rhAL').textContent = laps(agent.laps);
    $('rhAL').classList.toggle('is-bad', agent.laps === 0);
  }

  function warm(seconds: number) { for (let i = 0; i < seconds * 60; i++) step(1 / 60); }

  function setMode(next: 'points' | 'laps') {
    if (next === mode) return;
    agent.fx = agentPos.x; agent.fy = agentPos.y; agent.blend = 0;
    mode = next;
    // Join the race beside the other boat rather than teleporting onto the line.
    if (mode === 'laps') agent.th = human.th - 0.5;
    human.pts = human.laps = agent.pts = agent.laps = 0;
    document.querySelectorAll<HTMLButtonElement>('.rh [data-mode]').forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.mode === mode)));
    if (reduce) { agent.blend = 1; warm(8); }
    draw();
  }
  document.querySelectorAll<HTMLButtonElement>('.rh [data-mode]').forEach((b) =>
    b.addEventListener('click', () => setMode(b.dataset.mode as 'points' | 'laps')));

  warm(8);
  draw();

  if (!reduce) {
    let running = false, prev = 0;
    const loop = (now: number) => {
      if (!running) return;
      step(Math.min(0.05, (now - prev) / 1000)); prev = now;
      draw();
      requestAnimationFrame(loop);
    };
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !running) { running = true; prev = performance.now(); requestAnimationFrame(loop); }
      else if (!e.isIntersecting) running = false;
    }).observe(document.querySelector('.rh')!);
  }
</script>
