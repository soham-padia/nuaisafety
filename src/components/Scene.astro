---
/**
 * The home page scene: Boston from across the Charles, flat and bold, in
 * shades of Northeastern red.
 *
 * Landmarks, left to right: the Longfellow Bridge and its salt-and-pepper
 * towers, the Prudential and its mast, 111 Huntington's dome, the slanted
 * Hancock, a row of Back Bay brownstones along the water, sailboats, and the
 * Esplanade in front with its lamps, benches and people.
 *
 * The page sets --p on an ancestor, 0 to 1 through the home section, and the
 * CSS ("scene" in global.css) moves whole groups from it:
 *
 *   calm        the city as it is
 *   rising      a dark new tower rises behind the skyline, with cranes
 *   spreading   drones arrive, the boats leave, windows turn red outward
 *               from the tower
 *   storm       the sky turns crimson, smoke rises, people leave the path
 *   collapse    buildings tilt and sink, the city goes dark except for the
 *               tower and the fires
 *
 * Everything is plain filled shapes, no SVG filters, so a scroll only moves
 * a few groups and repaints cheaply. Paper grain is a separate, static CSS
 * layer on top.
 *
 * Without JavaScript --p stays 0 and the scene is the calm city.
 */

const W = 800;
const H = 900;
const WATER = 560;

function prng(a: number) {
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rnd = prng(17);
const between = (a: number, b: number) => a + rnd() * (b - a);
const n = (v: number) => Math.round(v * 10) / 10;

const C = {
  r50: '#fdf2f3',
  r100: '#f8dde1',
  r200: '#f0b9c2',
  r300: '#e48d9b',
  r400: '#d65468',
  r500: '#c8102e',
  r700: '#9b0c24',
  r900: '#4c0612',
  ink: '#1f1517',
  paper: '#ffffff',
};

/* --- the far city -------------------------------------------------------- */
let far = '';
for (let x = -10; x < W; ) {
  const w = between(18, 46);
  const top = between(420, 512);
  far += `<rect x="${n(x)}" y="${n(top)}" width="${n(w)}" height="${n(WATER - top)}"/>`;
  x += w + between(-4, 3);
}

/* --- the skyline --------------------------------------------------------- */
type B = { x: number; w: number; top: number; falls?: number };
const plain: B[] = [
  { x: 30, w: 52, top: 404, falls: -1 },
  { x: 88, w: 46, top: 366 },
  { x: 140, w: 54, top: 428, falls: 1 },
  { x: 440, w: 46, top: 352, falls: -1 },
  { x: 492, w: 40, top: 404 },
  { x: 604, w: 50, top: 382 },
  { x: 660, w: 44, top: 336, falls: 1 },
  { x: 710, w: 52, top: 414 },
  { x: 766, w: 44, top: 372, falls: -1 },
];

function building(b: B, crown = false) {
  const { x, w, top } = b;
  const shape = crown
    ? `<path d="M${x} ${WATER}V${top + 12}L${x + w / 2} ${top - 10}L${x + w} ${top + 12}V${WATER}Z" fill="${C.r200}"/>`
    : `<rect x="${x}" y="${top}" width="${w}" height="${WATER - top}" fill="${C.r200}"/>`;
  const shade = `<rect x="${n(x + w * 0.64)}" y="${top + (crown ? 12 : 0)}" width="${n(w * 0.36)}" height="${WATER - top - (crown ? 12 : 0)}" fill="${C.r300}"/>`;
  // a few window stripes, not a grid
  let stripes = '';
  for (let k = 1; k < 3; k++) {
    stripes += `<rect x="${n(x + w * (k / 3) - 1.5)}" y="${top + 22}" width="3" height="${WATER - top - 34}" fill="${C.paper}" opacity="0.45"/>`;
  }
  return shape + shade + stripes;
}

/* Red windows, lit outward from the tower as the story spreads. Small dabs in
   the same places as the stripes, so they read as the building lighting up. */
function lit(b: B) {
  let out = '';
  for (let y = b.top + 26; y < WATER - 14; y += 16) {
    for (let k = 1; k < 3; k++) {
      if (rnd() < 0.25) continue;
      out += `<rect x="${n(b.x + b.w * (k / 3) - 3)}" y="${y}" width="6" height="7" rx="1"/>`;
    }
  }
  return out;
}

let skyline = '';
let litWindows = '';
for (const b of plain) {
  const body = building(b, b.x === 604);
  skyline += b.falls
    ? `<g class="fall fall--${b.falls > 0 ? 'r' : 'l'}" style="--d:${n(rnd())}">${body}</g>`
    : body;
  litWindows += lit(b);
}

/* The Prudential: a tall slab with a stepped crown and a mast. */
const pru = { x: 206, w: 62, top: 252 };
skyline +=
  `<g class="fall fall--l" style="--d:0.4">` +
  `<path d="M${pru.x} ${WATER}V${pru.top + 18}H${pru.x + 8}V${pru.top}H${pru.x + pru.w - 8}V${pru.top + 18}H${pru.x + pru.w}V${WATER}Z" fill="${C.r200}"/>` +
  `<rect x="${pru.x + pru.w * 0.64}" y="${pru.top + 18}" width="${n(pru.w * 0.36)}" height="${WATER - pru.top - 18}" fill="${C.r300}"/>` +
  Array.from({ length: 16 }, (_, k) => `<rect x="${pru.x + 3}" y="${pru.top + 30 + k * 17}" width="${pru.w - 6}" height="2" fill="${C.paper}" opacity="0.5"/>`).join('') +
  `<rect x="${pru.x + pru.w / 2 - 2}" y="${pru.top - 78}" width="4" height="80" fill="${C.r300}"/>` +
  `</g>`;
litWindows += lit({ x: pru.x, w: pru.w, top: pru.top });

/* 111 Huntington: a slimmer tower with a domed crown and a spire. */
const hunt = { x: 284, w: 42, top: 330 };
skyline +=
  `<g class="fall fall--r" style="--d:0.7">` +
  `<rect x="${hunt.x}" y="${hunt.top}" width="${hunt.w}" height="${WATER - hunt.top}" fill="${C.r200}"/>` +
  `<path d="M${hunt.x - 2} ${hunt.top}A${hunt.w / 2 + 2} ${hunt.w / 2 + 2} 0 0 1 ${hunt.x + hunt.w + 2} ${hunt.top}Z" fill="${C.r300}"/>` +
  `<rect x="${hunt.x + hunt.w / 2 - 1.5}" y="${hunt.top - 50}" width="3" height="30" fill="${C.r300}"/>` +
  `<rect x="${n(hunt.x + hunt.w * 0.64)}" y="${hunt.top}" width="${n(hunt.w * 0.36)}" height="${WATER - hunt.top}" fill="${C.r300}"/>` +
  `</g>`;
litWindows += lit(hunt);

/* The Hancock: glass, slanted, with a notch down its face. */
const han = { x: 360, w: 58, top: 228 };
skyline +=
  `<g class="fall fall--r" style="--d:0.2">` +
  `<path d="M${han.x} ${WATER}V${han.top + 14}L${han.x + han.w} ${han.top}V${WATER}Z" fill="${C.r100}"/>` +
  `<path d="M${han.x + han.w * 0.55} ${WATER}V${han.top + 6}L${han.x + han.w} ${han.top}V${WATER}Z" fill="${C.r200}"/>` +
  `<path d="M${han.x + 8} ${WATER}L${han.x + 26} ${han.top + 60}L${han.x + 34} ${han.top + 60}L${han.x + 16} ${WATER}Z" fill="${C.paper}" opacity="0.55"/>` +
  `</g>`;
litWindows += lit({ x: han.x, w: han.w, top: han.top + 14 });

/* --- the new tower, with cranes ------------------------------------------- */
const T = { x: 540, w: 46, top: 132 };
const tcx = T.x + T.w / 2;
let bands = '';
for (let y = T.top + 30; y < WATER - 8; y += 18) {
  bands += `<rect x="${T.x + 7}" y="${y}" width="${T.w - 14}" height="2.4" fill="${C.r500}" class="band" style="--i:${n((WATER - y) / (WATER - T.top))}"/>`;
}
const crane = (mx: number, dir: number) =>
  `<path d="M${mx} ${WATER}V170M${mx - 5} ${WATER}V170M${mx - 5} ${WATER}L${mx} ${WATER - 30}M${mx} 170H${mx + dir * 120}M${mx} 170H${mx - dir * 36}` +
  `M${mx} 152L${mx + dir * 80} 170M${mx} 152L${mx - dir * 30} 170M${mx + dir * 92} 170V222" stroke="${C.ink}" stroke-width="2" fill="none"/>` +
  `<rect x="${dir > 0 ? mx - 36 : mx + 24}" y="170" width="12" height="9" fill="${C.ink}"/>` +
  `<rect x="${mx + dir * 92 - 5}" y="222" width="10" height="8" fill="${C.ink}"/>`;
const tower =
  `<path d="M${T.x} ${WATER}L${T.x + 4} ${T.top + 24}L${tcx} ${T.top}L${T.x + T.w - 4} ${T.top + 24}L${T.x + T.w} ${WATER}Z" fill="${C.ink}"/>` +
  `<rect x="${tcx - 1.2}" y="${T.top - 54}" width="2.4" height="56" fill="${C.ink}"/>` +
  `<rect x="${tcx - 1}" y="${T.top + 10}" width="2" height="${WATER - T.top - 10}" fill="${C.r500}" opacity="0.85"/>` +
  bands +
  crane(T.x + T.w + 26, 1) +
  crane(T.x - 22, -1);

/* --- brownstones and the trees along the water ----------------------------- */
let rows = '';
const RCOL = [C.r500, C.r700, C.r400, C.r700, C.r500];
for (let x = -4; x < W; ) {
  const w = between(22, 32);
  const h = between(36, 52);
  const top = WATER - h;
  const col = RCOL[Math.floor(rnd() * RCOL.length)];
  rows += `<rect x="${n(x)}" y="${n(top)}" width="${n(w)}" height="${n(h)}" fill="${col}"/>`;
  rows += `<path d="M${n(x)} ${n(top)}L${n(x + 3)} ${n(top - 7)}H${n(x + w - 3)}L${n(x + w)} ${n(top)}Z" fill="${C.r900}"/>`;
  for (let y = top + 7; y < WATER - 10; y += 11) {
    for (let k = 0; k < 2; k++) {
      rows += `<rect x="${n(x + 5 + k * (w - 13))}" y="${n(y)}" width="3.5" height="6" fill="${C.paper}" opacity="0.85"/>`;
    }
  }
  x += w + between(0.5, 2);
}
let streetTrees = '';
for (let x = 6; x < W; x += between(22, 36)) {
  const r = between(9, 15);
  streetTrees += `<circle cx="${n(x)}" cy="${n(WATER - r * 0.55)}" r="${n(r)}" fill="${rnd() < 0.5 ? C.r300 : C.r200}"/>`;
}

/* --- the river ------------------------------------------------------------- */
let ripples = '';
for (let i = 0; i < 26; i++) {
  const y = between(WATER + 10, 700), x = between(-40, 760), len = between(30, 140);
  ripples += `<rect x="${n(x)}" y="${n(y)}" width="${n(len)}" height="2" rx="1" fill="${C.paper}" opacity="0.9"/>`;
}
let reflect = '';
for (const b of [...plain, pru, hunt, { x: han.x, w: han.w, top: han.top }]) {
  reflect += `<rect x="${b.x}" y="${WATER + 6}" width="${b.w}" height="${n((WATER - b.top) * 0.32)}"/>`;
}
const towerReflect = `<rect x="${T.x + 6}" y="${WATER + 6}" width="${T.w - 12}" height="${n((WATER - T.top) * 0.32)}"/>`;

/* The Longfellow Bridge, low on the left, with its salt-and-pepper towers. */
const pepper = (x: number) =>
  `<rect x="${x - 7}" y="590" width="14" height="22" fill="${C.ink}"/>` +
  `<path d="M${x - 9} 590Q${x} 574 ${x + 9} 590Z" fill="${C.ink}"/>`;
let arches = '';
for (let x = -20; x < 290; x += 46) arches += `<path d="M${x} 640Q${x + 23} 610 ${x + 46} 640Z" fill="${C.r50}"/>`;
const bridge =
  `<rect x="-20" y="610" width="300" height="30" fill="${C.r300}"/>` +
  arches +
  `<rect x="-20" y="606" width="304" height="6" fill="${C.ink}"/>` +
  pepper(90) + pepper(190);

/* --- boats ---------------------------------------------------------------- */
const boat = (x: number, y: number, s: number) =>
  `<path d="M${x} ${y - 52 * s}V${y - 4 * s}H${x + 30 * s}Z" fill="${C.paper}" stroke="${C.ink}" stroke-width="1.5"/>` +
  `<path d="M${x - 3 * s} ${y - 44 * s}V${y - 4 * s}H${x - 18 * s}Z" fill="${C.paper}" stroke="${C.ink}" stroke-width="1.5"/>` +
  `<path d="M${x - 20 * s} ${y}H${x + 32 * s}L${x + 26 * s} ${y + 7 * s}H${x - 14 * s}Z" fill="${C.r500}"/>`;
const boats = boat(380, 662, 1) + boat(520, 690, 0.8) + boat(670, 650, 0.9);

/* --- drones ---------------------------------------------------------------- */
const drone = (x: number, y: number, s: number) =>
  `<g transform="translate(${n(x)} ${n(y)}) scale(${n(s)})">` +
  `<path d="M-10 -6L10 6M10 -6L-10 6" stroke="${C.ink}" stroke-width="2.2"/>` +
  `<rect x="-16" y="-9" width="12" height="3" rx="1.5" fill="${C.ink}"/><rect x="4" y="-9" width="12" height="3" rx="1.5" fill="${C.ink}"/>` +
  `<rect x="-16" y="5" width="12" height="3" rx="1.5" fill="${C.ink}"/><rect x="4" y="5" width="12" height="3" rx="1.5" fill="${C.ink}"/>` +
  `<rect x="-6" y="-3.5" width="12" height="7" rx="2" fill="${C.ink}"/>` +
  `<circle cy="5.5" r="2.4" fill="${C.r500}"/></g>`;
let drones = '';
for (let i = 0; i < 5; i++) {
  drones += drone(520 + i * 46, 230 + i * 22, 1.15);
  if (i) drones += drone(520 + i * 46, 230 - i * 8, 1.05);
}
for (let i = 0; i < 6; i++) drones += drone(between(60, 460), between(170, 400), between(0.7, 1.1));

/* --- the near bank --------------------------------------------------------- */
const ground =
  `<rect x="-10" y="700" width="${W + 20}" height="${H - 700 + 10}" fill="${C.r100}"/>` +
  `<path d="M-10 760H${W + 10}V806H-10Z" fill="${C.paper}"/>`;
let rail = `<rect x="-10" y="712" width="${W + 20}" height="3" fill="${C.ink}"/><rect x="-10" y="724" width="${W + 20}" height="2" fill="${C.ink}"/>`;
for (let x = 4; x < W; x += 24) rail += `<rect x="${x}" y="708" width="2.4" height="22" fill="${C.ink}"/>`;
const lamp = (x: number) =>
  `<rect x="${x - 2}" y="650" width="4" height="112" fill="${C.ink}"/>` +
  `<rect x="${x - 8}" y="640" width="16" height="14" rx="3" fill="${C.ink}"/>` +
  `<rect x="${x - 5}" y="644" width="10" height="7" rx="1" fill="${C.r100}" class="lamp"/>`;
const bench = `<rect x="430" y="738" width="66" height="5" fill="${C.ink}"/><rect x="430" y="726" width="66" height="4" fill="${C.ink}"/><rect x="434" y="743" width="4" height="17" fill="${C.ink}"/><rect x="488" y="743" width="4" height="17" fill="${C.ink}"/>`;

/* Two big trees framing the view. Each canopy is one mass: a light crown of
   tightly overlapping circles over a darker one, offset down and outward so
   it reads as shade on the side away from the sun. */
const canopy = (cx: number, cy: number, s: number, dir: number, light: string, dark: string) => {
  const lobes = [
    [0, 0, 1], [-0.62, 0.22, 0.72], [0.62, 0.2, 0.76], [-0.3, -0.48, 0.7], [0.36, -0.44, 0.66],
    [-0.86, 0.6, 0.5], [0.88, 0.6, 0.52], [0, 0.55, 0.8],
  ];
  const disc = (fill: string, dx: number, dy: number, grow: number) =>
    lobes.map(([x, y, r]) => `<circle cx="${n(cx + (x + dx) * s)}" cy="${n(cy + (y + dy) * s)}" r="${n(r * s * grow)}"/>`).join('');
  return `<g fill="${dark}">${disc(dark, 0.12 * dir, 0.16, 1)}</g><g fill="${light}">${disc(light, 0, 0, 0.92)}</g>`;
};
const tree = (x: number, dir: number, light: string, dark: string) =>
  `<path d="M${x} ${H + 10}C${x + dir * 6} 830 ${x - dir * 4} 770 ${x + dir * 16} 700" stroke="${C.ink}" stroke-width="15" fill="none" stroke-linecap="round"/>` +
  `<path d="M${x + dir * 6} 770Q${x + dir * 34} 740 ${x + dir * 58} 724" stroke="${C.ink}" stroke-width="6" fill="none" stroke-linecap="round"/>` +
  canopy(x + dir * 22, 630, 62, dir, light, dark);
const trees = tree(34, 1, C.r400, C.r700) + tree(772, -1, C.r500, C.r900);

/* People on the path. */
const BASE = 800;
const person = (x: number, h = 40, accent = '') =>
  `<circle cx="${x}" cy="${BASE - h + 5}" r="5" fill="${C.ink}"/>` +
  `<path d="M${x - 6} ${BASE - h + 12}H${x + 6}L${x + 8} ${BASE - 14}H${x - 8}Z" fill="${accent || C.ink}"/>` +
  `<path d="M${x - 2.5} ${BASE - 14}L${x - 4} ${BASE}M${x + 2.5} ${BASE - 14}L${x + 4} ${BASE}" stroke="${C.ink}" stroke-width="3" stroke-linecap="round"/>`;
const people =
  person(230) + person(248, 37, C.r500) +
  person(330, 41) +
  `<path d="M318 ${BASE - 46}Q330 ${BASE - 66} 342 ${BASE - 46}Z" fill="${C.r500}"/><rect x="329" y="${BASE - 58}" width="2" height="22" fill="${C.ink}"/>` +
  person(560, 38) +
  `<rect x="572" y="${BASE - 12}" width="18" height="7" rx="2" fill="${C.ink}"/><circle cx="592" cy="${BASE - 15}" r="4" fill="${C.ink}"/>` +
  `<path d="M574 ${BASE - 5}V${BASE}M586 ${BASE - 5}V${BASE}" stroke="${C.ink}" stroke-width="2"/>` +
  `<path d="M565 ${BASE - 26}Q572 ${BASE - 20} 576 ${BASE - 12}" stroke="${C.ink}" stroke-width="1" fill="none"/>` +
  person(462, 30) +
  person(640, 26, C.r700) +
  `<path d="M644 ${BASE - 22}Q652 ${BASE - 46} 648 ${BASE - 62}" stroke="${C.ink}" stroke-width="1" fill="none"/><ellipse cx="648" cy="${BASE - 70}" rx="7" ry="9" fill="${C.r500}"/>`;

/* Smoke, rising from the city late on. */
let smoke = '';
for (let i = 0; i < 18; i++) {
  const k = i / 17;
  smoke += `<circle cx="${n(tcx - 40 - k * 420 + between(-20, 20))}" cy="${n(380 - k * 300 + between(-20, 20))}" r="${n(26 + k * 70)}"/>`;
}

/* Fires at the waterline at the very end: a flame with a lighter core. */
const flame = (x: number, h: number, w: number) =>
  `M${n(x - w)} ${WATER}C${n(x - w)} ${n(WATER - h * 0.45)} ${n(x - w * 0.2)} ${n(WATER - h * 0.55)} ${n(x)} ${n(WATER - h)}` +
  `C${n(x + w * 0.15)} ${n(WATER - h * 0.6)} ${n(x + w)} ${n(WATER - h * 0.5)} ${n(x + w)} ${WATER}Z`;
let fires = '';
let cores = '';
for (let i = 0; i < 9; i++) {
  const x = between(30, 780), h = between(30, 64), w = between(10, 16);
  fires += `<path d="${flame(x, h, w)}"/>`;
  cores += `<path d="${flame(x + 1, h * 0.55, w * 0.5)}"/>`;
}

const svg = `
<defs>
  <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${C.r50}"/><stop offset="1" stop-color="${C.paper}"/></linearGradient>
  <linearGradient id="dusk" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3a0610"/><stop offset="0.55" stop-color="${C.r700}"/><stop offset="1" stop-color="${C.r400}"/></linearGradient>
  <clipPath id="above"><rect x="-50" y="-50" width="${W + 100}" height="${WATER + 50}"/></clipPath>
  <mask id="spread"><circle class="spread" cx="${tcx}" cy="${T.top + 120}" r="560" fill="#fff"/></mask>
</defs>
<rect width="${W}" height="${WATER}" fill="url(#sky)"/>
<rect class="dusk" width="${W}" height="${WATER}" fill="url(#dusk)"/>
<circle class="sun sun--day" cx="620" cy="240" r="64" fill="${C.r100}"/>
<circle class="sun sun--red" cx="620" cy="240" r="64" fill="${C.r500}"/>
<g class="clouds" fill="${C.paper}">
  <rect x="70" y="150" width="190" height="26" rx="13"/><rect x="110" y="134" width="90" height="26" rx="13"/>
  <rect x="440" y="96" width="160" height="22" rx="11"/><rect x="480" y="82" width="70" height="22" rx="11"/>
</g>
<g class="smoke" fill="${C.r900}">${smoke}</g>
<g fill="${C.r100}">${far}</g>
<g clip-path="url(#above)">
  <g class="tower">${tower}</g>
  ${skyline}
</g>
<g class="lit" fill="${C.r500}" mask="url(#spread)">${litWindows}</g>
<g>${rows}</g>
<g>${streetTrees}</g>
<rect y="${WATER}" width="${W}" height="${700 - WATER}" fill="${C.r50}"/>
<g fill="${C.r100}">${reflect}</g>
<g class="tower-reflect" fill="${C.r200}">${towerReflect}</g>
<g>${ripples}</g>
<g>${bridge}</g>
<g class="boats">${boats}</g>
<g class="drones">${drones}</g>
<g>${ground}${rail}${lamp(170)}${lamp(400)}${lamp(620)}${bench}</g>
<g class="people">${people}</g>
<g>${trees}</g>
<rect class="night" width="${W}" height="${H}" fill="#14070a"/>
<g class="fires"><g fill="#ff5a6e">${fires}</g><g fill="#ffd0d6">${cores}</g></g>
<g class="glow">
  <circle cx="${tcx}" cy="${T.top - 54}" r="7" fill="#ff4a60"/>
  <rect x="${tcx - 1.2}" y="${T.top + 10}" width="2.4" height="${WATER - T.top - 10}" fill="#ff4a60"/>
</g>
`;
---
<svg
  class="scene"
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid slice"
  role="img"
  aria-label="Boston from across the Charles: the Prudential, the Hancock, red Back Bay brownstones, sailboats, the Longfellow Bridge and people on the Esplanade. As you scroll, a dark new tower rises, drones arrive, the boats and people leave, windows turn red, the sky turns crimson, and at the end buildings tilt and sink as the city goes dark."
  set:html={svg}
/>
