---
import { PHOTO_PX, type Person } from '../config';

/** One tile on /team: photo or initials plate, name, title, then whatever
    optional details the person has filled in. */
interface Props {
  person: Person;
  role: string;
}

const { person, role } = Astro.props;

/** Initials for the fallback plate. Two letters at most, so a long name does
    not produce a row of letters that reads as a word. */
const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .map((part) => part[0])
    .slice(0, 2)
    .join('');
---
<li class="person">
  <div class="portrait">
    {person.photo ? (
      /* Alt is empty on purpose. The name is the next line of text,
         so a filled alt would read the person out twice. */
      <img src={person.photo} alt="" width={PHOTO_PX} height={PHOTO_PX} />
    ) : (
      <span class="portrait__initials" aria-hidden="true">{initials(person.name)}</span>
    )}
  </div>
  <span class="name">{person.name}</span>
  <span class="role">{role}</span>
  {/* Separate lines rather than one joined line. A column this
      narrow wraps a separator to the end of a line, where it
      reads as a typo. */}
  {person.program && <span class="person__meta">{person.program}</span>}
  {person.level && <span class="person__meta">{person.level}</span>}
  {person.bio && <p>{person.bio}</p>}
  {(person.email || person.linkedin) && (
    <span class="person__links">
      {person.email && (
        <a href={`mailto:${person.email}`} aria-label={`Email ${person.name}`}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M2.4 4.8h19.2c.66 0 1.2.54 1.2 1.2v12c0 .66-.54 1.2-1.2 1.2H2.4c-.66 0-1.2-.54-1.2-1.2V6c0-.66.54-1.2 1.2-1.2zm9.6 7.63L3.6 7.05V18h16.8V7.05L12 12.43zM12 10.6l7.8-4.6H4.2l7.8 4.6z"/>
          </svg>
        </a>
      )}
      {person.linkedin && (
        <a href={person.linkedin} aria-label={`${person.name} on LinkedIn`}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/>
          </svg>
        </a>
      )}
    </span>
  )}
</li>
