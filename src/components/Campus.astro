---
/**
 * The campus, drawn once in fine line at the foot of every page, standing on
 * the footer rule. After Harvard AISST, who end their pages on a drawing of
 * their own campus: in the flow of the page, so it is only seen at the end,
 * and still.
 *
 * Back Bay behind (the Pru, Hancock), a columned brick building, the curved
 * glass building, and the E train on Huntington.
 *
 * The only thing that ever changes is the people. As the work is handed away
 * (--tb rises) they leave, the way the checkers leave the desk in the hero;
 * as it is handed to people (--g) more arrive. Nothing moves on its own,
 * nothing is labelled, and no page draws a different picture. The hope is a
 * visitor who comes back to a page and thinks: wasn't there someone there?
 */
const range = (a: number, b: number, step: number) => {
  const out: number[] = [];
  for (let v = a; v <= b; v += step) out.push(v);
  return out;
};
const G = 199; // ground, which sits on the footer rule

const windowsA = [108, 132, 156].flatMap((y) => range(186, 486, 26).filter((x) => x < 278 || x > 392).map((x) => [x, y]));
const windowsC = [132, 160].flatMap((y) => range(876, 1070, 26).map((x) => [x, y]));
const windowsD = [142, 168].flatMap((y) => range(1394, 1550, 26).map((x) => [x, y]));
const trees: [number, number, number][] = [[128, 150, 26], [528, 146, 28], [842, 154, 22], [1356, 158, 20], [1588, 150, 24]];

// Who is there to begin with, and the order they leave in (scattered, not left to right).
const PEOPLE = [232, 452, 560, 706, 868, 1012, 1092, 1468];
const ORDER = [3, 0, 6, 2, 5, 1, 7, 4];
const people = PEOPLE.map((x, i) => ({ x, s: [1, .92, 1.06][i % 3], at: +(.1 + (ORDER[i] / 7) * .75).toFixed(3) }));
// Who arrives in the good ending.
const extra = [150, 300, 392, 622, 782, 944, 1050, 1430, 1514].map((x, i) => ({ x, s: [.94, 1.04, .9][i % 3], at: +(.1 + ((i * 4) % 9) / 9 * .8).toFixed(3) }));
const figure = (x: number, s: number) =>
  `M${x - 4.6 * s},${G} Q${x - 4.6 * s},${G - 11 * s} ${x},${G - 11 * s} Q${x + 4.6 * s},${G - 11 * s} ${x + 4.6 * s},${G} Z`;
---
<div class="campus wrap" aria-hidden="true">
  <svg viewBox="0 0 1600 200" preserveAspectRatio="xMidYMax slice">
    <g class="campus__line campus__far">
      <rect x="1110" y="34" width="46" height="165" />
      <rect x="1119" y="22" width="28" height="12" />
      <path d="M1133,2 L1133,22" />
      <path d="M1196,199 L1196,46 L1240,36 L1240,199 Z" />
      {[[1290, 90, 38], [1336, 118, 30], [930, 92, 34], [972, 120, 28], [60, 128, 40], [108, 110, 34]].map(([x, y, w]) =>
        <rect x={x} y={y} width={w} height={G - y} />)}
    </g>

    <g class="campus__line campus__near">
      <rect x="170" y="96" width="330" height="103" />
      <path d="M164,96 L506,96 M164,91 L506,91 M286,96 L335,72 L384,96" />
      {range(296, 374, 15.6).map((x) => <path d={`M${x.toFixed(1)},100 L${x.toFixed(1)},${G}`} />)}
      {windowsA.map(([x, y]) => <rect x={x} y={y} width="10" height="12" />)}

      <path d={`M540,${G} L540,112 Q680,64 820,112 L820,${G} Z`} />
      {[134, 154, 174].map((y) => <path d={`M540,${y} L820,${y}`} />)}

      <rect x="860" y="118" width="230" height="81" />
      <path d="M854,118 L1096,118" />
      {windowsC.map(([x, y]) => <rect x={x} y={y} width="10" height="12" />)}

      <rect x="1380" y="128" width="190" height="71" />
      {windowsD.map(([x, y]) => <rect x={x} y={y} width="10" height="12" />)}

      {trees.map(([x, y, r]) => (
        <g>
          <path d={`M${x},${y + r * .6} L${x},${G}`} />
          <circle cx={x - r * .28} cy={y} r={r * .82} />
          <circle cx={x + r * .42} cy={y + r * .22} r={r * .64} />
        </g>
      ))}
      {[470, 905, 1262].map((x) => <path d={`M${x},${G} L${x},150 M${x - 6},150 L${x + 6},150`} />)}

      <path d="M1132,166 L1388,166" class="campus__wire" />
      <rect x="1150" y="172" width="220" height="25" rx="6" />
      <path d="M1258,172 L1258,166" />
      {range(0, 5, 1).map((i) => <rect x={1162 + i * 34} y="178" width="20" height="9" rx="1.5" />)}
    </g>

    {people.map((p) => <path class="campus__person cx-out" style={`--at:${p.at}`} d={figure(p.x, p.s)} />)}
    {people.map((p) => <circle class="campus__person cx-out" style={`--at:${p.at}`} cx={p.x} cy={G - 15 * p.s} r={3.4 * p.s} />)}
    {extra.map((p) => <path class="campus__person cg-in" style={`--at:${p.at}`} d={figure(p.x, p.s)} />)}
    {extra.map((p) => <circle class="campus__person cg-in" style={`--at:${p.at}`} cx={p.x} cy={G - 15 * p.s} r={3.4 * p.s} />)}
  </svg>
</div>
