---
/**
 * The home page scene: a skyline across a river, drawn on a canvas.
 *
 * It fills the pinned frame of the scroll story and reads one number, p, from
 * 0 (top of the story) to 1 (end of it):
 *
 *   p near 0   a pale city on a white sky, hazy towers behind, all of it
 *              mirrored in the water
 *   as p rises the sky deepens toward a dark red; the dark glass tower's seam
 *              and beacon light; thin glowing lines reach out from it to the
 *              roofs and pulses run along them; windows turn red, nearest the
 *              tower first; drones gather; a searchlight sweeps; the sun
 *              becomes a low red disc; embers rise at the very end
 *
 * The layout is generated once from a seed, in proportions rather than pixels,
 * so it redraws crisply at any size. Windows take their timing from a hash of
 * their position, so there is nothing per-window to store.
 *
 * Small ambient motion (blinking lights, pulses, ripples) runs only while the
 * story is on screen, and not at all under reduced motion; scrolling still
 * moves the story either way.
 */
---
<canvas
  class="city"
  role="img"
  aria-label="A city across a river. As you scroll, the sky darkens to red, a dark tower lights up and sends glowing lines to every roof, windows turn red outward from it, drones gather and the sun becomes a low red disc."
  data-city
></canvas>

<script>
  type RGB = [number, number, number];

  const canvas = document.querySelector<HTMLCanvasElement>('[data-city]');
  const story = canvas?.closest<HTMLElement>('[data-story]');

  if (canvas && story) {
    const ctx = canvas.getContext('2d')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');

    /* --- colour helpers ------------------------------------------------- */
    const hex = (h: string): RGB => [
      parseInt(h.slice(1, 3), 16),
      parseInt(h.slice(3, 5), 16),
      parseInt(h.slice(5, 7), 16),
    ];
    const mix = (a: RGB, b: RGB, k: number): RGB => [
      a[0] + (b[0] - a[0]) * k,
      a[1] + (b[1] - a[1]) * k,
      a[2] + (b[2] - a[2]) * k,
    ];
    /* Day to night through a soft pink dusk and then a deep crimson, so the
       change never passes through a muddy grey on the way. */
    const stops = (cs: string[]) => cs.map(hex);
    const walk = (cs: RGB[], k: number): RGB => {
      const n = cs.length - 1;
      const i = Math.min(n - 1, Math.floor(k * n));
      return mix(cs[i], cs[i + 1], k * n - i);
    };
    const css = (c: RGB, a = 1) =>
      `rgba(${Math.round(c[0])},${Math.round(c[1])},${Math.round(c[2])},${a})`;
    const clamp = (v: number, lo = 0, hi = 1) => Math.min(hi, Math.max(lo, v));
    const ramp = (p: number, a: number, b: number) => {
      const t = clamp((p - a) / (b - a));
      return t * t * (3 - 2 * t);
    };
    /* A stable 0..1 value for any pair of integers. */
    const hash = (a: number, b: number) => {
      let h = Math.imul(a * 374761393 + b * 668265263, 1274126177);
      h = Math.imul(h ^ (h >>> 13), 1274126177);
      return ((h ^ (h >>> 16)) >>> 0) / 4294967296;
    };

    /* Each scene colour as stops: day, dusk, crimson, night. */
    const C = {
      skyTop: stops(['#ffffff', '#f6e4e7', '#6d1424', '#0e0507']),
      skyLow: stops(['#f4f2f2', '#eab4bd', '#b3243a', '#5c0c19']),
      far: stops(['#e0dcdc', '#d9a9b1', '#6e2230', '#3a141c']),
      faceTop: stops(['#f1efef', '#e9d3d7', '#4a1a24', '#2b1218']),
      faceLow: stops(['#dcd7d7', '#c99da5', '#2e0f16', '#12080b']),
      water: stops(['#ebe7e7', '#e2bcc3', '#3d0a14', '#090304']),
      waterLow: stops(['#f6f4f4', '#f6e4e7', '#2a070d', '#090304']),
      unlit: stops(['#c9c3c3', '#b98d95', '#4a1d27', '#24131a']),
      towerTop: hex('#3a3a40'),
      towerLow: hex('#0f0f12'),
      towerTopDay: hex('#9a9aa3'),
      towerLowDay: hex('#4a4a52'),
      red: hex('#e3203d'),
      redHot: hex('#ff4d63'),
    };

    /* --- the scene, in proportions ---------------------------------------- */
    let seed = 23;
    const rnd = () => {
      seed |= 0;
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };

    type Bldg = { x: number; w: number; h: number; kind: number; t: number };
    const far: { x: number; w: number; h: number }[] = [];
    for (let i = 0; i < 46; i++) {
      far.push({ x: rnd(), w: 0.008 + rnd() * 0.03, h: 0.12 + rnd() * 0.28 });
    }

    const mid: Bldg[] = [];
    for (let x = 0.0; x < 1; ) {
      const w = 0.03 + rnd() * 0.05;
      mid.push({ x, w: Math.min(w, 1 - x), h: 0.22 + rnd() * 0.5, kind: Math.floor(rnd() * 5), t: 0 });
      x += w + 0.004 + rnd() * 0.01;
    }
    /* The tower: a little right of centre in the city, the tallest thing. */
    const towerAt = 0.56;
    const tower = { x: towerAt - 0.026, w: 0.052, h: 0.92 };
    for (let i = mid.length - 1; i >= 0; i--) {
      const b = mid[i];
      if (b.x < tower.x + tower.w + 0.004 && b.x + b.w > tower.x - 0.004) mid.splice(i, 1);
    }
    for (const b of mid) {
      const d = Math.abs(b.x + b.w / 2 - towerAt);
      b.t = 0.16 + d * 0.95 + rnd() * 0.06;
    }

    const drones = Array.from({ length: 30 }, () => ({
      x: 0.05 + rnd() * 0.9,
      y: 0.12 + rnd() * 0.45,
      dx: (rnd() - 0.5) * 0.25,
      t: 0.3 + rnd() * 0.55,
      ph: rnd() * Math.PI * 2,
    }));
    const embers = Array.from({ length: 60 }, () => ({
      x: rnd(),
      off: rnd(),
      speed: 0.25 + rnd() * 0.5,
      size: 0.6 + rnd() * 1.4,
      sway: rnd() * Math.PI * 2,
    }));

    /* --- sizing ---------------------------------------------------------- */
    let W = 0, H = 0, dpr = 1;
    let city: HTMLCanvasElement, cctx: CanvasRenderingContext2D;
    let glow: HTMLCanvasElement, gctx: CanvasRenderingContext2D;
    const GLOW = 6; // the glow layer is drawn at 1/6 size and scaled up soft

    function resize() {
      const r = canvas!.getBoundingClientRect();
      dpr = Math.min(2, devicePixelRatio || 1);
      W = r.width;
      H = r.height;
      canvas!.width = Math.round(W * dpr);
      canvas!.height = Math.round(H * dpr);
      city = document.createElement('canvas');
      city.width = canvas!.width;
      city.height = canvas!.height;
      cctx = city.getContext('2d')!;
      glow = document.createElement('canvas');
      glow.width = Math.max(1, Math.round(W / GLOW));
      glow.height = Math.max(1, Math.round(H / GLOW));
      gctx = glow.getContext('2d')!;
    }

    /* Where things go at this size. On a wide screen the city keeps to the
       right and leaves sky for the text; on a narrow one it spans the width
       and sits lower, under the text. */
    function frame() {
      const wide = W >= 900;
      const horizon = H * (wide ? 0.72 : 0.86);
      const x0 = wide ? W * 0.38 : -W * 0.04;
      const x1 = wide ? W * 1.01 : W * 1.04;
      /* On a phone the text takes the top of the screen, so the city stays
         short enough to keep clear of it. */
      const tall = wide ? horizon * 0.6 : H * 0.27;
      return { wide, horizon, x0, span: x1 - x0, tall };
    }

    function progress() {
      const total = story!.offsetHeight - innerHeight;
      return clamp(-story!.getBoundingClientRect().top / Math.max(1, total));
    }

    /* --- drawing --------------------------------------------------------- */
    function outline(g: CanvasRenderingContext2D, kind: number, x: number, y: number, w: number, h: number) {
      g.beginPath();
      if (kind === 1) {
        // setback: a narrower block on top
        const s = w * 0.16, k = h * 0.68;
        g.moveTo(x, y);
        g.lineTo(x, y - k);
        g.lineTo(x + s, y - k);
        g.lineTo(x + s, y - h);
        g.lineTo(x + w - s, y - h);
        g.lineTo(x + w - s, y - k);
        g.lineTo(x + w, y - k);
        g.lineTo(x + w, y);
      } else if (kind === 3) {
        // crown: a shallow pyramid roof
        g.moveTo(x, y);
        g.lineTo(x, y - h * 0.88);
        g.lineTo(x + w / 2, y - h);
        g.lineTo(x + w, y - h * 0.88);
        g.lineTo(x + w, y);
      } else if (kind === 4) {
        // slanted roof
        g.moveTo(x, y);
        g.lineTo(x, y - h);
        g.lineTo(x + w, y - h * 0.86);
        g.lineTo(x + w, y);
      } else {
        g.rect(x, y - h, w, h);
      }
      g.closePath();
    }

    function draw(time: number) {
      if (!W || !H) return;
      const p = progress();
      const f = frame();
      const night = ramp(p, 0.3, 0.95);
      const ink = ramp(p, 0.2, 0.9);

      const skyTop = walk(C.skyTop, night);
      const skyLow = walk(C.skyLow, ramp(p, 0.2, 0.95));

      /* Everything above the waterline goes on the city layer first, so the
         reflection can be taken from it. */
      const g = cctx;
      g.setTransform(dpr, 0, 0, dpr, 0, 0);
      g.clearRect(0, 0, W, H);

      gctx.setTransform(1 / GLOW, 0, 0, 1 / GLOW, 0, 0);
      gctx.clearRect(0, 0, W, H);
      gctx.globalCompositeOperation = 'lighter';

      // sky
      const sky = g.createLinearGradient(0, 0, 0, f.horizon);
      sky.addColorStop(0, css(skyTop));
      sky.addColorStop(1, css(skyLow));
      g.fillStyle = sky;
      g.fillRect(0, 0, W, f.horizon);

      // sun, low over the city, swelling into a red disc
      const sx = f.x0 + f.span * 0.8, sy = f.horizon - f.tall * 0.42;
      const sr = f.tall * (0.1 + p * 0.09);
      const sunCol = mix(hex('#efe9e9'), C.red, ramp(p, 0.15, 0.8));
      const halo = g.createRadialGradient(sx, sy, sr * 0.6, sx, sy, sr * 4);
      halo.addColorStop(0, css(sunCol, 0.25 + 0.35 * p));
      halo.addColorStop(1, css(sunCol, 0));
      g.fillStyle = halo;
      g.fillRect(sx - sr * 4, sy - sr * 4, sr * 8, sr * 8);
      g.fillStyle = css(sunCol, 0.55 + 0.4 * p);
      g.beginPath();
      g.arc(sx, sy, sr, 0, Math.PI * 2);
      g.fill();

      // the far city, behind haze
      const farCol = walk(C.far, night);
      g.fillStyle = css(farCol, 0.75);
      for (const b of far) {
        const x = b.x * W * 1.05 - W * 0.02;
        const h = b.h * f.tall * 0.55;
        g.fillRect(x, f.horizon - h, b.w * W, h);
      }
      const haze = g.createLinearGradient(0, f.horizon - f.tall * 0.5, 0, f.horizon);
      haze.addColorStop(0, css(skyLow, 0));
      haze.addColorStop(1, css(skyLow, 0.75));
      g.fillStyle = haze;
      g.fillRect(0, f.horizon - f.tall * 0.5, W, f.tall * 0.5);

      // searchlight from the tower top, late on
      const tx = f.x0 + towerAt * f.span;
      const ty = f.horizon - tower.h * f.tall;
      const beam = ramp(p, 0.55, 0.8);
      if (beam > 0) {
        const a = -Math.PI / 2 + Math.sin(time * 0.00035) * 0.9;
        const len = f.tall * 2.2, spread = 0.07;
        const bg = g.createRadialGradient(tx, ty - 24, 0, tx, ty - 24, len);
        bg.addColorStop(0, css(C.redHot, 0.28 * beam));
        bg.addColorStop(1, css(C.redHot, 0));
        g.fillStyle = bg;
        g.beginPath();
        g.moveTo(tx, ty - 24);
        g.lineTo(tx + Math.cos(a - spread) * len, ty - 24 + Math.sin(a - spread) * len);
        g.lineTo(tx + Math.cos(a + spread) * len, ty - 24 + Math.sin(a + spread) * len);
        g.closePath();
        g.fill();
      }

      // the network: thin lines from the tower tip to each roof
      const tipY = ty - f.tall * 0.09;
      for (let i = 0; i < mid.length; i++) {
        const b = mid[i];
        if (hash(i, 11) < 0.45) continue; // only about half the roofs get a line
        const grow = clamp((p - (b.t - 0.06)) * 4.5);
        if (grow <= 0) continue;
        const rx = f.x0 + (b.x + b.w / 2) * f.span;
        const ry = f.horizon - b.h * f.tall;
        const cx = (tx + rx) / 2;
        const cy = Math.min(tipY, ry) - f.tall * (0.02 + hash(i, 7) * 0.3);
        const n = 28, m = Math.max(1, Math.round(n * grow));
        const pt = (s: number): [number, number] => {
          const u = 1 - s;
          return [u * u * tx + 2 * u * s * cx + s * s * rx, u * u * tipY + 2 * u * s * cy + s * s * ry];
        };
        for (const c of [g, gctx]) {
          c.strokeStyle = css(C.red, c === g ? 0.4 : 0.6);
          c.lineWidth = c === g ? 0.8 : 2.5;
          c.beginPath();
          c.moveTo(tx, tipY);
          for (let k = 1; k <= m; k++) c.lineTo(...pt(k / n));
          c.stroke();
        }
        if (grow >= 1) {
          // a pulse running out along the line
          const s = (time * 0.00035 + hash(i, 3)) % 1;
          const [px, py] = pt(s);
          for (const c of [g, gctx]) {
            c.fillStyle = css(C.redHot, 1);
            c.beginPath();
            c.arc(px, py, c === g ? 1.6 : 4, 0, Math.PI * 2);
            c.fill();
          }
        }
      }

      // the city
      const faceTop = walk(C.faceTop, night);
      const faceLow = walk(C.faceLow, night);
      const unlit = walk(C.unlit, night);
      for (let i = 0; i < mid.length; i++) {
        const b = mid[i];
        const x = f.x0 + b.x * f.span, w = b.w * f.span, h = b.h * f.tall;
        const face = g.createLinearGradient(0, f.horizon - h, 0, f.horizon);
        face.addColorStop(0, css(faceTop));
        face.addColorStop(1, css(faceLow));
        g.fillStyle = face;
        outline(g, b.kind, x, f.horizon, w, h);
        g.fill();
        // a lit edge on the left, a shaded one on the right
        g.fillStyle = css([255, 255, 255], 0.5 * (1 - night));
        g.fillRect(x, f.horizon - h * (b.kind === 1 ? 0.68 : 0.9), 1, h * (b.kind === 1 ? 0.68 : 0.9));
        g.fillStyle = css([0, 0, 0], 0.07 + 0.2 * night);
        g.fillRect(x + w * 0.72, f.horizon - h * 0.86, w * 0.28, h * 0.86);
        if (b.kind === 2) {
          g.strokeStyle = css(faceLow);
          g.lineWidth = 1.2;
          g.beginPath();
          g.moveTo(x + w / 2, f.horizon - h);
          g.lineTo(x + w / 2, f.horizon - h - f.tall * 0.1);
          g.stroke();
        }

        // windows
        const cols = Math.max(2, Math.floor(w / 6.5));
        const rows = Math.floor((h * 0.84) / 8.5);
        const gx = w / cols;
        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            const hv = hash(i * 131 + r, c);
            if (hv < 0.18) continue;
            const wx = x + c * gx + gx * 0.3;
            const wy = f.horizon - 6 - (r + 1) * 8.5;
            if (b.kind === 1 && r * 8.5 > h * 0.66 && (c === 0 || c === cols - 1)) continue;
            const lit = clamp((p - b.t - hv * 0.14) * 9);
            // late on, some lights fail
            const out = p > 0.9 && hash(r, c * 17 + i) < (p - 0.9) * 4 ? 1 : 0;
            const level = lit * (1 - out);
            g.fillStyle = level > 0 ? css(mix(unlit, C.red, level)) : css(unlit, 0.75);
            g.fillRect(wx, wy, gx * 0.42, 4.2);
            if (level > 0.4) {
              gctx.fillStyle = css(C.red, 0.55 * level);
              gctx.fillRect(wx - 1, wy - 1, gx * 0.42 + 2, 6);
            }
          }
        }
      }

      // the tower: dark glass, tapered, with a seam and a needle
      const tw = tower.w * f.span, th = tower.h * f.tall, tl = tx - tw / 2;
      const glass = g.createLinearGradient(tl, 0, tl + tw, 0);
      const tTop = mix(C.towerTopDay, C.towerTop, ink);
      const tLow = mix(C.towerLowDay, C.towerLow, ink);
      glass.addColorStop(0, css(tTop));
      glass.addColorStop(0.45, css(tLow));
      glass.addColorStop(1, css(mix(tTop, tLow, 0.6)));
      g.fillStyle = glass;
      g.beginPath();
      g.moveTo(tl, f.horizon);
      g.lineTo(tl + tw * 0.1, f.horizon - th);
      g.lineTo(tl + tw * 0.9, f.horizon - th);
      g.lineTo(tl + tw, f.horizon);
      g.closePath();
      g.fill();
      // reflections on the glass
      g.fillStyle = css([255, 255, 255], 0.06 + 0.05 * (1 - night));
      g.fillRect(tl + tw * 0.2, f.horizon - th, tw * 0.08, th);
      // needle
      g.strokeStyle = css(C.towerTop);
      g.lineWidth = 2;
      g.beginPath();
      g.moveTo(tx, f.horizon - th);
      g.lineTo(tx, tipY);
      g.stroke();
      // the seam, lighting from the ground up
      const seam = ramp(p, 0.02, 0.5);
      if (seam > 0) {
        const top = f.horizon - th * seam;
        for (const c of [g, gctx]) {
          c.fillStyle = css(C.redHot, c === g ? 0.95 : 0.8);
          c.fillRect(tx - (c === g ? 0.75 : 3), top, c === g ? 1.5 : 6, f.horizon - top);
        }
      }
      // beacon
      const blink = reduce.matches ? 1 : 0.65 + 0.35 * Math.sin(time * 0.004);
      const br = 2 + 5 * ramp(p, 0, 0.7);
      for (const c of [g, gctx]) {
        c.fillStyle = css(C.redHot, c === g ? 1 : 0.9 * blink);
        c.beginPath();
        c.arc(tx, tipY, c === g ? br * 0.6 : br * 3, 0, Math.PI * 2);
        c.fill();
      }

      // drones
      for (const d of drones) {
        const a = clamp((p - d.t) * 6);
        if (a <= 0) continue;
        const x = f.x0 + (d.x + d.dx * p) * f.span;
        const y = f.horizon - f.tall * (0.55 + d.y) + Math.sin(time * 0.0015 + d.ph) * 3;
        g.fillStyle = css(mix(hex('#3b3434'), hex('#d9c8cb'), night), a);
        g.fillRect(x - 3, y - 0.8, 6, 1.6);
        g.fillRect(x - 0.8, y - 2, 1.6, 4);
        const on = reduce.matches || Math.sin(time * 0.005 + d.ph * 3) > 0.2;
        if (on) {
          for (const c of [g, gctx]) {
            c.fillStyle = css(C.redHot, a);
            c.beginPath();
            c.arc(x, y, c === g ? 1.3 : 4, 0, Math.PI * 2);
            c.fill();
          }
        }
      }

      // embers, rising at the very end
      const em = ramp(p, 0.8, 1);
      if (em > 0) {
        for (const e of embers) {
          const k = ((time * 0.00004 * e.speed + e.off) % 1);
          const x = f.x0 + e.x * f.span + Math.sin(time * 0.001 + e.sway) * 6;
          const y = f.horizon - k * f.tall * 1.3;
          g.fillStyle = css(C.redHot, em * (1 - k) * 0.9);
          g.fillRect(x, y, e.size, e.size);
        }
      }

      /* --- composite onto the visible canvas ----------------------------- */
      const out = ctx;
      out.setTransform(1, 0, 0, 1, 0, 0);
      out.clearRect(0, 0, canvas!.width, canvas!.height);
      out.drawImage(city, 0, 0);

      // water
      out.setTransform(dpr, 0, 0, dpr, 0, 0);
      const water = out.createLinearGradient(0, f.horizon, 0, H);
      water.addColorStop(0, css(walk(C.water, night)));
      water.addColorStop(1, css(walk(C.waterLow, night)));
      out.fillStyle = water;
      out.fillRect(0, f.horizon, W, H - f.horizon);

      // the reflection, taken from the city layer, flipped and rippled
      const depth = H - f.horizon;
      const strip = 2;
      out.setTransform(1, 0, 0, 1, 0, 0);
      for (let y = 0; y < depth; y += strip) {
        const k = y / depth;
        const wobble = Math.sin(y * 0.18 + time * 0.0018) * (0.6 + y * 0.04);
        out.globalAlpha = 0.42 * (1 - k) * (1 - k);
        out.drawImage(
          city,
          0, Math.max(0, (f.horizon - y - strip)) * dpr, canvas!.width, strip * dpr,
          wobble * dpr, (f.horizon + y) * dpr, canvas!.width, strip * dpr,
        );
      }
      out.globalAlpha = 1;

      // the glow, scaled up soft and added on top
      out.globalCompositeOperation = 'lighter';
      out.globalAlpha = 0.35 + 0.5 * ink;
      out.imageSmoothingEnabled = true;
      out.drawImage(glow, 0, 0, canvas!.width, canvas!.height);
      // and its reflection
      out.globalAlpha = 0.25 * ink;
      out.save();
      out.translate(0, f.horizon * 2 * dpr);
      out.scale(1, -1);
      out.drawImage(glow, 0, 0, canvas!.width, canvas!.height);
      out.restore();
      out.globalAlpha = 1;
      out.globalCompositeOperation = 'source-over';

      // the waterline
      out.setTransform(dpr, 0, 0, dpr, 0, 0);
      out.fillStyle = css(mix(hex('#cfc9c9'), hex('#5c1a26'), night), 0.8);
      out.fillRect(0, f.horizon, W, 1);
    }

    /* --- running it -------------------------------------------------------- */
    let visible = true;
    let looping = false;
    let queued = false;

    function loop(t: number) {
      draw(t);
      if (visible && !reduce.matches) requestAnimationFrame(loop);
      else looping = false;
    }
    function start() {
      if (looping || reduce.matches || !visible) return;
      looping = true;
      requestAnimationFrame(loop);
    }
    function once() {
      if (looping || queued) return;
      queued = true;
      requestAnimationFrame((t) => { queued = false; draw(t); });
    }

    resize();
    draw(0);
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) start();
    }).observe(story);
    addEventListener('scroll', once, { passive: true });
    addEventListener('resize', () => { resize(); once(); });
    reduce.addEventListener('change', () => { start(); once(); });
    start();
  }
</script>
