---
/**
 * The oversight control on every page except home, where the hero slider is the
 * control. Both write the same `--t` and the same sessionStorage key, so the
 * value set on one page is the value every other page opens with.
 */
---
<div class="pill" role="group" aria-label="Oversight">
  <label class="pill__label" for="pillRange">We check</label>
  <input class="ovs__range ovs__range--untouched pill__range" id="pillRange" type="range" min="0" max="100" step="1" value="0" />
  <output class="pill__out" for="pillRange" id="pillOut">everything</output>
</div>

<script>
  const KEY = 'nuais-t';
  const range = document.getElementById('pillRange') as HTMLInputElement;
  const out = document.getElementById('pillOut')!;
  const words = (v: number) =>
    v < 8 ? 'everything' : v < 35 ? 'most of it' : v < 65 ? 'some of it' : v < 92 ? 'very little' : 'nothing';

  function set(v: number, store: boolean) {
    const t = v / 100;
    document.documentElement.style.setProperty('--t', String(t));
    range.style.setProperty('--p', `${v}%`);
    out.textContent = words(v);
    range.setAttribute('aria-valuetext', `We check ${words(v)}`);
    if (store) {
      try { sessionStorage.setItem(KEY, String(t)); } catch { /* private mode */ }
      dispatchEvent(new Event('nuais:t'));
    }
  }

  let start = 0;
  try { start = Math.round(Math.min(1, Math.max(0, +(sessionStorage.getItem(KEY) ?? 0))) * 100); } catch { /* */ }
  range.value = String(start);
  set(start, false);
  if (start > 0) range.classList.remove('ovs__range--untouched');

  /* Holding the pill fades the page so you can see the campus behind it, and
     brings the page back a moment after you let go. The content is only ever
     hidden while the control is in use, never at rest. */
  let release = 0;
  const peek = () => {
    document.body.classList.add('is-peeking');
    clearTimeout(release);
    release = window.setTimeout(() => document.body.classList.remove('is-peeking'), 1400);
  };
  range.addEventListener('pointerdown', peek);
  range.addEventListener('input', () => {
    range.classList.remove('ovs__range--untouched');
    set(+range.value, true);
    peek();
  });
</script>
