---
import { SIGNUP_URL, mailtoHref } from '../config';

interface Props {
  /** "button" for a primary CTA, "inline" for a sentence-level link. */
  variant?: 'button' | 'inline';
  label?: string;
}

const { variant = 'button', label = 'Join the mailing list' } = Astro.props;

/* The form is the normal path. Without one we offer email instead, and with no
   address to publish either, /join explains every way in. The CTA is never a
   dead link and never says "email us" when there is nothing to email. */
const email = mailtoHref('Joining the mailing list');
const href = SIGNUP_URL ?? email ?? '/join';
const text = !SIGNUP_URL && email
  ? (variant === 'button' ? 'Email us to join' : 'email us to join')
  : label;
---
{variant === 'button' ? (
  <a class="btn" href={href}>{text} →</a>
) : (
  <a class="arrow" href={href}><span>{text}</span></a>
)}
