---
/**
 * Get involved: the four ways in, side by side, each one line and one link.
 * The two fellowship tracks and the executive board each have their own
 * section below with the detail; membership is just the Slack, so it is
 * complete here.
 */
import Icon from '../components/Icon.astro';
import { SLACK_URL, mailtoHref } from '../config';

const slackHref = SLACK_URL ?? mailtoHref('Joining the Slack');
---
<section class="band section" id="join" aria-labelledby="join-title">
  <div class="wrap">
    <h2 id="join-title" class="section-title dot">Get involved</h2>
    <p class="lede section-lede">
      There are four ways in. Anyone can become a member today. Fellowships start in January
      2027.
    </p>

    <ol class="ways">
      <li class="way">
        <Icon name="chat" />
        <h3>Member</h3>
        <p>Join our Slack and come to open meetings and talks. No commitment, open to everyone.</p>
        {slackHref && <a class="btn btn--small" href={slackHref}>Join the Slack</a>}
      </li>
      <li class="way">
        <Icon name="chip" />
        <h3>Technical Fellowship</h3>
        <p>8 weeks on how AI systems are trained and how to make them safer.</p>
        <a class="link-more" href="#fellowships">How the fellowships work</a>
      </li>
      <li class="way">
        <Icon name="policy" />
        <h3>Policy Fellowship</h3>
        <p>8 weeks on how AI should be governed. No technical background needed.</p>
        <a class="link-more" href="#fellowships">How the fellowships work</a>
      </li>
      <li class="way">
        <Icon name="flag" />
        <h3>Executive board</h3>
        <p>Help run the group. 3–5 hours a week, and no background needed.</p>
        <a class="link-more" href="#exec">What the board does</a>
      </li>
    </ol>

    <p class="note">
      <Icon name="cap" size={40} />
      <span>Open to undergraduate, master’s and PhD students in every program.</span>
    </p>
  </div>
</section>
