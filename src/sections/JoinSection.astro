---
/**
 * Get involved: the four ways in, side by side, each one line and one link.
 * The two fellowship tracks and the executive board each have their own
 * section below with the detail; membership is just the Slack, so it is
 * complete here.
 *
 * Each card is one link: the link's ::before stretches over the whole card,
 * so the card is clickable without nesting a link around block content.
 */
import Icon from '../components/Icon.astro';
import SpotlightCard from '../components/reactbits/SpotlightCard';
import { SLACK_URL, mailtoHref } from '../config';

const slackHref = SLACK_URL ?? mailtoHref('Joining the Slack');
---
<section class="band section" id="join" aria-labelledby="join-title">
  <div class="wrap">
    <h2 id="join-title" class="section-title dot">Get involved</h2>
    <p class="lede section-lede">
      There are four ways to get involved. Anyone can join as a member today, and fellowships
      begin in January 2027.
    </p>

    <div class="sideways">
    <ol class="ways">
      <li>
        <SpotlightCard client:visible className="way" theme="light" spotlightColor="#c8102e" intensity={0.5} spotlightSize={320}>
          <Icon name="chat" />
          <h3>Member</h3>
          <p>Join our Slack and come to our meetings and talks. Open to everyone, with no commitment.</p>
          {slackHref && <a class="btn btn--small way__link" href={slackHref}>Join the Slack</a>}
        </SpotlightCard>
      </li>
      <li>
        <SpotlightCard client:visible className="way" theme="light" spotlightColor="#1f6f78" intensity={0.5} spotlightSize={320}>
          <Icon name="chip" tone="river" />
          <h3>Technical Fellowship</h3>
          <p>An eight-week program on how AI systems are built and how to make them safer.</p>
          <a class="link-more way__link" href="#fellowships">How the fellowships work</a>
        </SpotlightCard>
      </li>
      <li>
        <SpotlightCard client:visible className="way" theme="light" spotlightColor="#e8a33d" intensity={0.55} spotlightSize={320}>
          <Icon name="policy" tone="sun" />
          <h3>Policy Fellowship</h3>
          <p>An eight-week program on how AI should be governed. No technical background required.</p>
          <a class="link-more way__link" href="#fellowships">How the fellowships work</a>
        </SpotlightCard>
      </li>
      <li>
        <SpotlightCard client:visible className="way" theme="light" spotlightColor="#a8432f" intensity={0.5} spotlightSize={320}>
          <Icon name="flag" tone="brick" />
          <h3>Executive board</h3>
          <p>Help lead the group. About 3–5 hours a week, and no prior experience required.</p>
          <a class="link-more way__link" href="#exec">What the board does</a>
        </SpotlightCard>
      </li>
    </ol>
    </div>

    <p class="note">
      <Icon name="cap" size={40} />
      <span>Open to undergraduate, master’s and PhD students in every program.</span>
    </p>
  </div>
</section>

<script>
  /* On a phone the four ways in are a row (global.css) that the page scroll
     moves sideways, pinned in view until the last card is in. */
  import { sideways } from '../scripts/sideways';
  const row = document.querySelector<HTMLElement>('.ways');
  if (row) sideways(row, '(max-width: 39.99rem)');
</script>
