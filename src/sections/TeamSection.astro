---
import PersonTile from '../components/PersonTile.astro';
import { TEAM, ADVISORS, FELLOWS, BOARD_TITLE, FELLOW_TITLE } from '../config';

/**
 * A headshot grid built to be good before the headshots exist.
 *
 * No photo has been taken yet, so every tile currently falls back to an
 * initials plate in the wash. That is a deliberate typographic mark, not a
 * stand-in face: a stock portrait or an illustrated avatar would be a small
 * lie about a group that has none of them.
 *
 * The plate and the photo occupy the same square, so adding a photo later is
 * one file in `public/team/` and one `photo:` line in `src/config.ts`. Nothing
 * about the layout moves.
 *
 * Program, level, bio, email, LinkedIn and website are all optional. They
 * render per person the moment they are filled in. Do not invent any of them.
 *
 * The page is centred: each group has a centred heading over a centred block
 * of tiles, four to a row, filled from the left.
 */

/* Tiles are sized for a name and a title. A paragraph needs more room, so
   the tiles widen the moment anyone has a bio. */
const hasBio = [...TEAM, ...ADVISORS, ...FELLOWS].some((person) => person.bio);
---
  <section class="band section" id="team" aria-labelledby="team-title">
    <div class="wrap team">
      <h1 id="team-title" class="section-title dot">Team</h1>

      <section class="team__group" aria-labelledby="exec-board">
        <h2 id="exec-board">Executive board</h2>
        <ul class:list={['people', 'team__grid', hasBio && 'team__grid--roomy']}>
          {TEAM.map((person) => (
            <PersonTile person={person} role={person.title ?? BOARD_TITLE} />
          ))}
        </ul>
      </section>

      {ADVISORS.length > 0 && (
        <section class="team__group" aria-labelledby="advisors">
          <h2 id="advisors">{ADVISORS.length > 1 ? 'Faculty advisors' : 'Faculty advisor'}</h2>
          <ul class:list={['people', 'team__grid', 'team__grid--row', hasBio && 'team__grid--roomy']}>
            {ADVISORS.map((person) => (
              <PersonTile person={person} role={person.title ?? 'Faculty Advisor'} />
            ))}
          </ul>
        </section>
      )}

      {FELLOWS.length > 0 && (
        <section class="team__group" aria-labelledby="fellows">
          <h2 id="fellows">Fellows</h2>
          <ul class:list={['people', 'team__grid', hasBio && 'team__grid--roomy']}>
            {FELLOWS.map((person) => (
              <PersonTile person={person} role={person.title ?? FELLOW_TITLE} />
            ))}
          </ul>
        </section>
      )}
    </div>
  </section>
<style>
  .team { text-align: center; }
  .team .section-title { margin-block-end: clamp(2rem, 1.5rem + 2vw, 3rem); }

  .team__group + .team__group { margin-block-start: clamp(3.5rem, 2.5rem + 4vw, 5.5rem); }
  .team__group h2 { font-size: var(--step-2); margin-block-end: 1.75rem; }

  /* The block of tiles is centred on the page, and the tiles fill it from the
     left, so a short last row lines up under the first column. Two across on
     a phone. From 46rem up the tiles are a fixed width and the block is capped
     at exactly four tiles plus their gaps, so it wraps at four. */
  .team__grid {
    --tile: 10.5rem;
    --gap: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 2rem var(--gap);
    margin-inline: auto;
  }
  .team__grid--roomy { --tile: 14rem; }
  /* a group that fits on one row, like the faculty advisor, is centred as a row */
  .team__grid--row { justify-content: center; }
  .team__grid > :global(li) { width: calc(50% - var(--gap) / 2); }
  @media (min-width: 46rem) {
    .team__grid { max-width: calc(4 * var(--tile) + 3 * var(--gap)); }
    .team__grid > :global(li) { width: var(--tile); }
  }

  .team :global(.person__links) { justify-content: center; }
</style>
