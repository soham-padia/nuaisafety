---
/**
 * The executive board: what it does, the four areas, what it takes, and the
 * application. Set on red, so it stands apart as the one section that asks
 * for real time.
 */
import ExecCTA from '../components/ExecCTA.astro';
---
<section class="band band--red section" id="exec" aria-labelledby="exec-title">
  <div class="wrap">
    <h2 id="exec-title" class="section-title">Executive board</h2>
    <p class="lede section-lede">
      The board runs the group. We are recruiting a few students to each take on one area this
      year.
    </p>

    <ul class="areas">
      <li><h3>Fellowships</h3><p>Organize the technical and policy fellowships.</p></li>
      <li><h3>Events</h3><p>Plan talks and socials.</p></li>
      <li><h3>Outreach</h3><p>Handle communications and bring in new members.</p></li>
      <li><h3>Partnerships</h3><p>Build connections with other AI safety groups and funders.</p></li>
    </ul>

    <dl class="facts-row">
      <div><dt>Time</dt><dd>3–5 hours a week, including one board meeting</dd></div>
      <div><dt>Background</dt><dd>None needed. Several roles are not technical.</dd></div>
      <div><dt>Co-op</dt><dd>We will work around it</dd></div>
    </dl>

    <div class="actions section-actions">
      <ExecCTA label="Apply to the executive board" />
    </div>
  </div>
</section>
