---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import { SITE, NAV, NAV_CTA, SOCIAL, EMAIL, KHOURY_CLUB_URL } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Social scrapers need an absolute URL; a root-relative path is silently ignored.
const ogImage = new URL('/og.png', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="NU AI Safety. AI safety and interpretability at Northeastern." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="masthead">
      <div class="wrap masthead__row">
        <a class="wordmark" href="/#top">NU AI Safety</a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
          <span class="sr-only">Menu</span>
          <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path class="menu-toggle__bars" d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
        <nav class="nav" id="site-nav" aria-label="Primary">
          {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
          <a class="btn btn--nav" href={NAV_CTA.href}>{NAV_CTA.label}</a>
        </nav>
      </div>
    </header>

    <script>
      /* Phone menu. Without JavaScript the toggle stays hidden and the links
         show in a wrapped row instead, so nothing is out of reach. */
      const head = document.querySelector('.masthead');
      const toggle = head?.querySelector<HTMLButtonElement>('.menu-toggle');
      if (head && toggle) {
        head.classList.add('has-menu');
        const set = (open: boolean) => {
          head.classList.toggle('is-open', open);
          toggle.setAttribute('aria-expanded', String(open));
        };
        toggle.addEventListener('click', () => set(!head.classList.contains('is-open')));
        head.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => set(false)));
        addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
      }
    </script>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        <div class="foot__row">
          <div>
            <p class="foot__name">Northeastern's Student Led AI Safety Group</p>
            <nav class="foot__nav" aria-label="Footer">
              {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
            </nav>
          </div>
          <div class="foot__contact">
            {EMAIL && (
              <p>
                <span class="foot__label">General inquiries</span>
                <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
              </p>
            )}
            {SOCIAL.length > 0 && (
              <p>
                <span class="foot__label">Follow</span>
                {SOCIAL.map((s) => <a href={s.href}>{s.label}</a>)}
              </p>
            )}
            <p>
              <span class="foot__label">Club</span>
              <a href={KHOURY_CLUB_URL}>Khoury clubs directory</a>
            </p>
          </div>
        </div>
        <p class="credit">
          <a href="https://github.com/soham-padia/nuaisafety">Source on GitHub</a>
        </p>
      </div>
    </footer>

    <script>
      /**
       * Smooth scrolling (Lenis) and gentle reveals (GSAP), site-wide.
       *
       * Lenis drives the scroll and GSAP's ticker drives Lenis, so the 3D city's
       * ScrollTrigger and the smooth scroll stay in step. Rules for the reveals:
       * never hide anything already on screen when the script runs, and with
       * reduced motion do none of this at all: native scroll, everything shown.
       */
      import Lenis from 'lenis';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!reduce) {
        const head = document.querySelector<HTMLElement>('.masthead');
        const lenis = new Lenis({
          lerp: 0.11,
          anchors: { offset: -(head?.offsetHeight ?? 64) },
        });
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((t) => lenis.raf(t * 1000));
        gsap.ticker.lagSmoothing(0);

        const items = gsap.utils.toArray<HTMLElement>(
          '.section-title, .section-lede, .way, .track, .flow li, .areas li, .person, .faq__item, .paper'
        ).filter((el) => el.getBoundingClientRect().top > innerHeight * 0.92);
        gsap.set(items, { opacity: 0, y: 28 });
        ScrollTrigger.batch(items, {
          start: 'top 90%',
          once: true,
          onEnter: (batch) =>
            gsap.to(batch, { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out', stagger: 0.07, overwrite: true, clearProps: 'transform' }),
        });
        // fonts and the city change the page height after load
        document.fonts?.ready.then(() => ScrollTrigger.refresh());
      }
    </script>
  </body>
</html>
