---
import '../styles/global.css';
import { SITE, NAV, EMAIL } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | ${SITE.tagline}`;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="masthead">
      <div class="wrap">
        <a class="wordmark" href="/">NU AI Safety</a>
        <nav class="nav" aria-label="Primary">
          {NAV.map((item) => (
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        <div class="cols">
          <div>
            <h2>NU AI Safety</h2>
            <p>
              A student-led AI safety and interpretability group at Northeastern.
              Not a recognised student organisation. We are working through that process.
            </p>
          </div>
          <div>
            <h2>Pages</h2>
            <ul>
              {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
            </ul>
          </div>
          <div>
            <h2>Contact</h2>
            <ul>
              <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
            </ul>
          </div>
        </div>
        <p class="fine">
          Run by students. Not affiliated with, endorsed by, or speaking for Northeastern
          University or Khoury College.
        </p>
      </div>
    </footer>

    <script>
      import { animate, inView, stagger } from 'motion';

      /**
       * Rules this follows, in order of importance:
       *
       * 1. Never strand content invisible. Only elements below the fold at script
       *    time are hidden, so anything the visitor can already see can never be
       *    hidden by us. A timeout un-hides anything the observer never reached.
       * 2. No flash. Hero text animates position only, never opacity, so there is
       *    no visible-then-hidden snap when the deferred module runs.
       * 3. The hero image is never animated. It is the LCP element and fading it
       *    would push the measurement out.
       */
      const reduce = matchMedia('(prefers-reduced-motion: reduce)');
      const spring = { type: 'spring', stiffness: 200, damping: 26 };

      function clear(el) {
        el.style.opacity = '';
        el.style.transform = '';
      }

      if (!reduce.matches) {
        const heroText = document.querySelectorAll('.hero__text > *');
        if (heroText.length) {
          animate(heroText, { y: [14, 0] }, { ...spring, delay: stagger(0.07) });
        }

        const reveals = Array.from(
          document.querySelectorAll('.block, .person, .callout, .prose > h2')
        );
        const hidden = new Set();

        for (const el of reveals) {
          if (el.getBoundingClientRect().top > innerHeight * 0.9) {
            el.style.opacity = '0';
            hidden.add(el);
          }
        }

        inView(
          reveals,
          (el) => {
            const wasHidden = hidden.delete(el);
            animate(el, wasHidden ? { opacity: [0, 1], y: [18, 0] } : { y: [18, 0] }, spring)
              .finished.then(() => clear(el), () => clear(el));
          },
          { amount: 0.15 }
        );

        // Failsafe: if the observer never fires for something, show it anyway.
        setTimeout(() => { hidden.forEach(clear); hidden.clear(); }, 4000);
      }
    </script>
  </body>
</html>
