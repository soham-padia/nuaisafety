---
import Base from '../layouts/Base.astro';
import Signup from '../components/Signup.astro';
import { EMAIL } from '../config';
---
<Base title="Join" description="Technical and policy fellowships for Northeastern students, and membership after.">
  <section class="band">
    <div class="wrap prose">
      <h1>Join</h1>
      <p class="lede">
        Most people start with one of our two fellowships, then go on to become members.
      </p>

      <div class="row">
        <h2>Programs</h2>
        <div>
        <div class="grid">
          <div class="block">
            <h3>Technical Fellowship</h3>
            <span class="meta">Weekly, about 90 minutes</span>
            <p>
              An introduction to the technical side of AI safety: how modern AI systems are trained,
              why aligning them is difficult, and current research in areas such as mechanistic
              interpretability.
            </p>
          </div>
          <div class="block">
            <h3>Policy Fellowship</h3>
            <span class="meta">Weekly, about 90 minutes</span>
            <p>
              An introduction to AI governance: the risks posed by advanced AI, how governments and
              companies are responding, and what effective policy could look like. No technical
              background required.
            </p>
          </div>
          <div class="block">
            <h3>Membership</h3>
            <span class="meta">After a fellowship</span>
            <p>
              Members work on AI safety alongside other students, through research projects and
              discussion of current work.
            </p>
          </div>
        </div>
        </div>
      </div>
      <div class="row">
        <h2>How to join</h2>
        <div>
        <p>
          Fellowships start in January 2027. Sign up for the mailing list, and we’ll email you
          before they begin.
        </p>
        <div class="actions">
          <Signup />
        </div>
        <p>
          Already have a background in AI safety?
          <a href={`mailto:${EMAIL}`}>Email us</a> about joining as a member directly.
        </p>
        </div>
      </div>
    </div>
  </section>
</Base>
