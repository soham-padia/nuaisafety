---
import Base from '../layouts/Base.astro';
import { EMAIL } from '../config';
---
<Base title="Contact" description="Get in touch about joining, speaking, or coordinating between AI safety groups.">
  <section class="band">
    <div class="wrap prose">
      <h1>Contact</h1>

      <p class="lede"><a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
      <p>For anything: joining, speaking, collaborating, or asking what we are.</p>
    </div>
  </section>
</Base>
