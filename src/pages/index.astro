---
import Base from '../layouts/Base.astro';
import Signup from '../components/Signup.astro';
import Halftone from '../components/Halftone.astro';
import JoinSection from '../sections/JoinSection.astro';
import TeamSection from '../sections/TeamSection.astro';
import ResourcesSection from '../sections/ResourcesSection.astro';
import { LUMA_CALENDAR_ID, LUMA_CALENDAR_URL } from '../config';
---
<Base>
  <section class="home" id="top" data-story>
    <div class="home__art">
      <Halftone />
    </div>

    <div class="home__text">
      <div class="home__step home__step--intro">
        <h1>NU AI Safety</h1>
        <p class="tagline">AI Safety at Northeastern</p>
        <p class="home__lede">
          We are a student-led group preparing Northeastern students to help align and govern
          advanced AI systems. We run technical and policy fellowships, host talks from
          researchers, and support student research.
        </p>
        <div class="actions">
          <Signup />
          <a class="btn btn--ghost" href="#what">What we do</a>
        </div>
      </div>

      <div class="home__step">
        <h2 id="what">What we do</h2>
        <h3>Fellowships</h3>
        <p>
          Weekly reading groups on the technical and policy sides of AI safety, from the
          fundamentals to current research.
        </p>
      </div>

      <div class="home__step">
        <h3>Guest talks</h3>
        <p>
          Talks from researchers in AI safety and interpretability, from across Boston and
          beyond.
        </p>
      </div>

      <div class="home__step">
        <h3>Research</h3>
        <p>
          Support for members pursuing their own AI safety research, with feedback and
          collaboration from other members and Northeastern faculty.
        </p>
      </div>

      <div class="home__step">
        <h2 id="whofor">Who this is for</h2>
        <p>
          <strong>AI safety needs more than just AI researchers and software engineers.</strong>
          Many of its most important problems concern policy, law, cybersecurity, biology, and
          psychology. Anyone interested in making AI go well is welcome!
        </p>
      </div>
    </div>
  </section>

  {LUMA_CALENDAR_ID && (
    <section class="band band--wash" aria-labelledby="events">
      <div class="wrap">
        <h2 id="events">Events</h2>
        <iframe
          class="events"
          src={`https://luma.com/embed/calendar/${LUMA_CALENDAR_ID}/events?lt=light`}
          title="Upcoming events"
          loading="lazy"
          allowfullscreen
        ></iframe>
        <p class="events__sub">
          <a class="arrow" href={LUMA_CALENDAR_URL}><span>Subscribe on Luma</span></a>
        </p>
      </div>
    </section>
  )}

  <JoinSection />
  <TeamSection />
  <ResourcesSection />

  <script>
    /* Two jobs, both on scroll, both cheap.

       1. The scroll story: how far through the pinned hero you are, 0 to 1,
          written to --p on the section. The city reads it in CSS.
       2. The menu: mark whichever section is on screen as the current one.

       Without this script the city stays a calm skyline and the menu still
       jumps to each section; nothing is hidden behind it. */
    const root = document.documentElement;
    const head = document.querySelector('.masthead');
    const story = document.querySelector('[data-story]');
    const links = [...document.querySelectorAll('.nav a[href^="/#"]')];
    const sections = links
      .map((a) => document.getElementById(a.getAttribute('href').slice(2)))
      .filter(Boolean);

    function measure() {
      if (head) root.style.setProperty('--head', head.offsetHeight + 'px');
    }

    function update() {
      if (story) {
        const total = story.offsetHeight - innerHeight;
        const p = Math.min(1, Math.max(0, -story.getBoundingClientRect().top / total));
        story.style.setProperty('--p', p.toFixed(4));
      }
      const line = (head ? head.offsetHeight : 0) + innerHeight * 0.25;
      let current = null;
      for (const sec of sections) if (sec.getBoundingClientRect().top <= line) current = sec;
      for (const a of links) {
        const on = current && a.getAttribute('href') === '/#' + current.id;
        if (on) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      }
    }

    let queued = false;
    function onScroll() {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; update(); });
    }

    measure();

    /* Arriving with a section in the address (an old /team link redirects to
       /#team, for example): go straight there. The browser does not always do
       it on its own after a redirect, and a smooth scroll the length of the
       story would be a slow way to arrive. */
    const target = location.hash && document.getElementById(location.hash.slice(1));
    if (target) target.scrollIntoView({ behavior: 'instant' });

    update();
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', () => { measure(); update(); });
  </script>
</Base>

<style>
  /* The section needs a heading for the outline; the three blocks carry the meaning. */
  .sr-only-heading {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Luma's list sizes itself to the frame, so the frame sets the height.
     Lazy, because it is well below the fold and would otherwise load with the page. */
  .events {
    display: block;
    width: 100%;
    height: 600px;
    margin-block-start: 1.5rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--paper);
  }
  .events__sub { margin-block: 1rem 0; font-size: 0.9375rem; }
</style>
