---
import Base from '../layouts/Base.astro';
import Signup from '../components/Signup.astro';
import Perceptron from '../components/Perceptron.astro';
---
<Base>
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <h1>NU AI Safety</h1>
        <p class="tagline">AI Safety at Northeastern</p>
        <p>
          We are a student-led group preparing Northeastern students to help align and govern
          advanced AI systems. We run technical and policy fellowships, host talks from
          researchers, and support student research.
        </p>
        <div class="actions">
          <Signup />
          <a class="btn btn--ghost" href="/about">What we do</a>
        </div>
      </div>
      <figure class="hero__art">
        <Perceptron />
        <figcaption>
          Organization of a perceptron, after Rosenblatt, 1958. Red marks the cells active for
          the input, and the response unit that fires as a result.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="band band--wash" aria-labelledby="what">
    <div class="wrap">
      <h2 id="what" class="sr-only-heading">What we do</h2>
      <div class="grid grid--3">
        <div class="block">
          <h3>Fellowships</h3>
          <span class="meta">Technical and policy</span>
          <p>
            Weekly reading groups on the technical and policy sides of AI safety, from the
            fundamentals to current research.
          </p>
        </div>
        <div class="block">
          <h3>Guest talks</h3>
          <span class="meta">On campus</span>
          <p>
            Talks from researchers in AI safety and interpretability, from across Boston and
            beyond.
          </p>
        </div>
        <div class="block">
          <h3>Research</h3>
          <span class="meta">Member projects</span>
          <p>
            Support for members pursuing their own AI safety research, with feedback and
            collaboration from other members and Northeastern faculty.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="whofor">
    <div class="wrap prose">
      <h2 id="whofor">Who this is for</h2>
      <p>
        <strong>AI safety needs more than just AI researchers and software engineers.</strong>
        Many of its most important problems concern policy, law, cybersecurity, biology, and psychology. Anyone
        interested in making AI go well is welcome!
      </p>
    </div>
  </section>

  <section class="band band--wash" aria-labelledby="new">
    <div class="wrap prose">
      <h2 id="new">Join Us!</h2>
      <p class="lede">Fellowships start in January 2027. Learn more <a href="/join">here</a>.</p>
      <div class="actions">
        <Signup />
      </div>
    </div>
  </section>
</Base>

<style>
  /* The section needs a heading for the outline; the three blocks carry the meaning. */
  .sr-only-heading {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

</style>
