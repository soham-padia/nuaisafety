---
import Base from '../layouts/Base.astro';
import SlackCTA from '../components/SlackCTA.astro';
import Oversight from '../components/Oversight.astro';
import Goodnews from '../components/Goodnews.astro';
import { LUMA_CALENDAR_ID, LUMA_CALENDAR_URL } from '../config';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base>
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <h1>NU AI Safety</h1>
        <p class="tagline">AI Safety at Northeastern</p>
        <p>
          We are a student-led group preparing Northeastern students to help align and govern
          advanced AI systems. We run technical and policy fellowships, host talks from
          researchers, and support student research.
        </p>
        <div class="actions">
          <SlackCTA />
          <a class="btn btn--ghost" href={`${base}/join`}>Other ways to join</a>
        </div>
      </div>
      <Oversight />
    </div>
  </section>

  {/* Two moments and plain type between them. The hero hands the work to the
      machine and the slider at the bottom hands it to people; everything in the
      middle is set as text, so neither moment has to compete. The column rules
      are the only thing here that reacts, and only by a shade. Nothing on this
      page should say one discipline comes first. */}
  <section class="band" aria-labelledby="paths">
    <div class="wrap">
      <h2 id="paths">Three different problems. Three different kinds of people.</h2>
      <p class="routes__lede">
        AI safety is not one problem with one kind of answer. The three routes people worry
        about most need different training, different rooms, and different arguments.
      </p>
      <div class="grid grid--3 routes">
        <article class="route">
          <h3>Loss of control</h3>
          <p>Systems that pursue something other than what we asked for, and that we cannot reliably stop.</p>
          <p class="route__who">Interpretability, evaluations</p>
        </article>
        <article class="route">
          <h3>Concentration of power</h3>
          <p>AI that lets a small group hold power nobody else can meaningfully challenge.</p>
          <p class="route__who">Governance, law, policy</p>
        </article>
        <article class="route">
          <h3>Biological misuse</h3>
          <p>Models that lower the barrier to designing a pathogen, and the defences against that.</p>
          <p class="route__who">Security, biology, public health</p>
        </article>
      </div>
      <p class="routes__note">
        This is roughly how <a href="https://bluedot.org/courses/agi-strategy">BlueDot's AGI Strategy
        course</a> splits the problem. We are not affiliated with them. Their curriculum is open, and
        it is a good place to start reading.
      </p>
    </div>
  </section>

  <section class="band band--wash" aria-labelledby="what">
    <div class="wrap">
      <h2 id="what" class="sr-only-heading">What we do</h2>
      <div class="grid grid--3">
        <div class="block">
          <h3>Fellowships</h3>
          <p>
            Weekly reading groups on the technical and policy sides of AI safety, from the
            fundamentals to current research.
          </p>
        </div>
        <div class="block">
          <h3>Guest talks</h3>
          <p>
            Talks from researchers in AI safety and interpretability, from across Boston and
            beyond.
          </p>
        </div>
        <div class="block">
          <h3>Research</h3>
          <p>
            Support for members pursuing their own AI safety research, with feedback and
            collaboration from other members and Northeastern faculty.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="whofor">
    <div class="wrap prose">
      <h2 id="whofor">Who this is for</h2>
      <p>
        <strong>AI safety needs more than just AI researchers and software engineers.</strong>
        Many of its most important problems concern policy, law, cybersecurity, biology, and psychology. Anyone
        interested in making AI go well is welcome!
      </p>
    </div>
  </section>

  {LUMA_CALENDAR_ID && (
    <section class="band band--wash" aria-labelledby="events">
      <div class="wrap">
        <h2 id="events">Events</h2>
        <iframe
          class="events"
          src={`https://luma.com/embed/calendar/${LUMA_CALENDAR_ID}/events?lt=light`}
          title="Upcoming events"
          loading="lazy"
          allowfullscreen
        ></iframe>
        <p class="events__sub">
          <a class="arrow" href={LUMA_CALENDAR_URL}><span>Subscribe on Luma</span></a>
        </p>
      </div>
    </section>
  )}

  <Goodnews />
</Base>

<style>
  /* The section needs a heading for the outline; the three blocks carry the meaning. */
  .sr-only-heading {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Luma's list sizes itself to the frame, so the frame sets the height.
     Lazy, because it is well below the fold and would otherwise load with the page. */
  .events {
    display: block;
    width: 100%;
    height: 600px;
    margin-block-start: 1.5rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--paper);
  }
  .events__sub { margin-block: 1rem 0; font-size: 0.9375rem; }
</style>
