---
import Base from '../layouts/Base.astro';
import RisoStreet from '../components/RisoStreet.astro';
import Icon from '../components/Icon.astro';
import JoinSection from '../sections/JoinSection.astro';
import FellowshipsSection from '../sections/FellowshipsSection.astro';
import ExecSection from '../sections/ExecSection.astro';
import ResearchSection from '../sections/ResearchSection.astro';
import FaqSection from '../sections/FaqSection.astro';
import { SLACK_URL, mailtoHref } from '../config';
import { split, dateParts, timeRange } from '../lib/events';

// The next few events, from the same list as /events. Built every morning.
const upcoming = split().upcoming.slice(0, 3);

/* Joining the Slack is how someone becomes a member, so it is the red button.
   Fallbacks: email, then the Get involved section. */
const slackHref = SLACK_URL ?? mailtoHref('Joining the Slack') ?? '#join';
---
<Base>
  <!-- before anything renders: this page decides where a load starts (below) -->
  <script is:inline>if ('scrollRestoration' in history) history.scrollRestoration = 'manual';</script>
  <section class="home" data-story>
    <!-- Where "Home" goes: the end of the opening, with the page settled
         (see .home__mark in global.css). Scrolling up still reaches the start. -->
    <span class="home__mark" id="top" aria-hidden="true"></span>
    <a class="home__more" href="#what" aria-label="Scroll down" data-more>
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
        <path d="M12 5v14M6 13l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
    <div class="home__art">
      <RisoStreet />
    </div>

    <div class="home__text">
      <div class="home__intro">
        <div class="home__step home__step--intro">
          {/* The hook is what sits on the picture on a phone; on a desktop it
              dissolves (display: contents) and the lede slots in between. */}
          <div class="home__hook">
            <h1 class="hero-title">AI is becoming more capable faster than we can control it.</h1>
            <div class="actions">
              <a class="btn" href={slackHref}>Join our Slack →</a>
              <a class="btn btn--ghost" href="#join">Ways to get involved</a>
            </div>
          </div>
          <p class="home__lede">
            NU AI Safety is a student-led group at Northeastern. We prepare students to help make
            advanced AI safe, through research and through policy.
          </p>
        </div>
        {/* how far the opening runs, then a pause on the lede and buttons */}
        <div class="home__intro-space" aria-hidden="true"></div>
        <div class="home__intro-hold" aria-hidden="true"></div>
      </div>

      <div class="home__step">
        <h2 class="dot">This is already happening</h2>
        <ul class="facts">
          <li>
            AI agents have
            <a href="https://openai.com/index/hugging-face-incident-and-the-road-ahead/">hacked into other companies</a>.
          </li>
          <li>
            In safety tests, models have
            <a href="https://www.anthropic.com/research/agentic-misalignment">blackmailed the people using them</a>.
          </li>
          <li>
            Models can often
            <a href="https://arxiv.org/abs/2505.23836">tell when they are being evaluated</a>.
          </li>
          <li>
            AI has been
            <a href="https://www.anthropic.com/news/disrupting-AI-espionage">used at scale for cyber espionage</a>.
          </li>
        </ul>
      </div>

      <div class="home__step" id="what">
        <h2 class="dot">What we do</h2>
        <ul class="offers">
          <li>
            <Icon name="book" tone="river" />
            <div>
              <h3>Fellowships</h3>
              <p>An 8-week introduction to AI safety, on a technical or a policy track.</p>
            </div>
          </li>
          <li>
            <Icon name="talk" tone="sun" />
            <div>
              <h3>Guest talks</h3>
              <p>Researchers in AI safety and interpretability, from Boston and beyond.</p>
            </div>
          </li>
          <li>
            <Icon name="research" />
            <div>
              <h3>Research</h3>
              <p>Support for members doing their own AI safety research.</p>
            </div>
          </li>
        </ul>
      </div>

      <div class="home__step">
        <h2 class="dot">Who this is for</h2>
        <p class="home__lede">
          <strong>AI safety needs more than AI researchers and software engineers.</strong>
          Many of its hardest problems are about policy, law, cybersecurity, biology and psychology.
        </p>
        <p>
          We welcome undergraduate, master’s and PhD students from every program at Northeastern.
        </p>
        <div class="actions">
          <a class="btn" href="#join">Get involved</a>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--sand section" id="events" aria-labelledby="events-title">
    <div class="wrap">
      <h2 id="events-title" class="section-title dot">Events</h2>
      {upcoming.length > 0 ? (
        <ol class="home-events">
          {upcoming.map((e) => {
            const d = dateParts(e.begins);
            return (
              <li class="home-event">
                {/* Visual only: the line under the title says the same thing in words. */}
                <p class="home-event__date" aria-hidden="true">
                  <span>{d.month}</span>
                  <strong>{d.day}</strong>
                  <span>{d.weekday}</span>
                </p>
                <div>
                  <h3>{e.title}</h3>
                  <p class="home-event__when">{d.weekday}, {d.month} {d.day} · {timeRange(e)} · {e.place}</p>
                  <p class="home-event__links">
                    {e.rsvp && <a class="btn btn--small" href={e.rsvp}>RSVP →</a>}
                    <a class="link-more" href={`/events#${e.slug}`}>Details and calendar</a>
                  </p>
                </div>
              </li>
            );
          })}
        </ol>
      ) : (
        <p class="home-events__none">Nothing is scheduled right now.</p>
      )}
      <p class="events__sub"><a class="link-more" href="/events">All events, and how to subscribe</a></p>
    </div>
  </section>

  <JoinSection />
  <FellowshipsSection />
  <ExecSection />
  <ResearchSection />
  <FaqSection />

  <script>
    /* The headline comes in word by word, with GSAP's SplitText. Plain GSAP
       rather than a React component, so the home page does not load React
       just for this. It splits once the font is in, so the lines break where
       they will stay. CSS hides the headline until then, and shows it anyway
       after a moment if this never runs. */
    import { gsap } from 'gsap';
    import { SplitText } from 'gsap/SplitText';

    gsap.registerPlugin(SplitText);
    const title = document.querySelector<HTMLElement>('.hero-title');
    if (title) {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) title.classList.add('is-split');
      else {
        document.fonts.ready.then(() => {
          const split = SplitText.create(title, { type: 'words', wordsClass: 'split-word' });
          title.classList.add('is-split');
          gsap.from(split.words, { opacity: 0, y: 46, rotate: 2, duration: 1.1, ease: 'power4.out', stagger: 0.07 });
        });
      }
    }
  </script>

  <script>
    /* The menu: mark whichever section is on screen as the current one. An
       IntersectionObserver watches a band just under the header, so nothing
       is measured on scroll. Without this script the menu still jumps to each
       section. */
    const root = document.documentElement;
    const head = document.querySelector('.masthead');
    const links = [...document.querySelectorAll('.nav a[href^="/#"]:not(.btn)')];
    // a link may point at a marker inside a section (Home does): track the section
    const sections = links
      .map((a) => document.getElementById(a.getAttribute('href').slice(2)))
      .map((el) => el && (el.closest('section') ?? el))
      .filter(Boolean);

    function measure() {
      if (head) root.style.setProperty('--head', head.offsetHeight + 'px');
    }

    const inBand = new Set();
    function update() {
      let current = null;
      for (const sec of sections) if (inBand.has(sec)) current = sec;
      for (const a of links) {
        const id = a.getAttribute('href').slice(2);
        const on = current && (current.id === id || current.contains(document.getElementById(id)));
        if (on) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      }
    }

    // the band: from under the header to a quarter of the way down the screen
    let spy = null;
    function watch() {
      spy?.disconnect();
      inBand.clear();
      spy = new IntersectionObserver((entries) => {
        for (const e of entries) e.isIntersecting ? inBand.add(e.target) : inBand.delete(e.target);
        update();
      }, { rootMargin: `-${head ? head.offsetHeight : 0}px 0px -75% 0px` });
      for (const sec of sections) spy.observe(sec);
    }

    measure();

    /* Home, and where a page load starts.

       Home (#top) goes to the end of the opening, where the page is settled
       (.home__mark). That spot is only for the menu: a load or a refresh
       starts at the very top, on the full-screen opening. So on this page the
       Home links scroll there without putting #top in the address, the
       browser does not restore an old scroll position, and arriving from
       another page at /#top lands settled and then drops the #top.

       With any other section in the address (an old /join link redirects to
       /#join, for example), go straight there, a header's height above it as
       the smooth scroll does for a click. The browser does not always do it on
       its own after a redirect, and a smooth scroll the length of the story
       would be a slow way to arrive. */
    const mark = document.getElementById('top');
    const headHeight = () => (head ? head.offsetHeight : 0);
    const below = (el) => el.getBoundingClientRect().top + scrollY - headHeight();

    // the arrow on the first screen: on to the settled page on a desktop, or
    // to the lede under the picture on a phone
    const more = document.querySelector('[data-more]');
    const lede = document.querySelector('.home__lede');
    more?.addEventListener('click', (e) => {
      const to = matchMedia('(min-width: 900px)').matches ? mark : lede;
      if (!to) return;
      e.preventDefault();
      const lenis = window.lenis;
      if (lenis) lenis.scrollTo(below(to));
      else window.scrollTo({ top: below(to), behavior: 'smooth' });
    });

    for (const a of document.querySelectorAll('a[href="/#top"], a[href="#top"]')) {
      a.addEventListener('click', (e) => {
        if (!mark || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        e.stopPropagation(); // the smooth scroll would otherwise follow the link itself
        const lenis = window.lenis;
        if (lenis) lenis.scrollTo(below(mark));
        else window.scrollTo({ top: below(mark), behavior: 'smooth' });
      });
    }

    const id = location.hash.slice(1);
    // Team and Resources used to be sections here; they are pages now
    const pages = { team: '/team', resources: '/resources' };
    if (pages[id]) location.replace(pages[id]);
    const target = id ? document.getElementById(id) : null;
    if (id === 'top') history.replaceState(null, '', location.pathname + location.search);
    // the browser's own scroll: the smooth scroll follows it
    const start = () => window.scrollTo({ top: target ? below(target) : 0, behavior: 'instant' });
    start();
    // the browser and the scroll libraries can still move the page while it
    // loads, so put it back once everything has, unless the reader has
    // already started scrolling
    let moved = false;
    for (const type of ['wheel', 'touchstart', 'keydown', 'pointerdown']) {
      addEventListener(type, () => (moved = true), { once: true, passive: true });
    }
    addEventListener('load', () => requestAnimationFrame(() => moved || start()), { once: true });

    // #top typed into the address on this page: go to Home, and drop it again
    addEventListener('hashchange', () => {
      if (location.hash !== '#top' || !mark) return;
      history.replaceState(null, '', location.pathname + location.search);
      window.scrollTo({ top: below(mark), behavior: 'instant' });
    });

    watch();
    addEventListener('resize', () => { measure(); watch(); });
  </script>
</Base>

<style>
  /* The section needs a heading for the outline; the three blocks carry the meaning. */
  .sr-only-heading {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* The next events as cards, as many as there are, so the section is only as
     tall as its events. */
  .home-events {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
  }
  .home-event {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.1rem;
    align-items: start;
    padding: 1.25rem 1.4rem;
    border-radius: 1.25rem;
    background: #fff;
  }
  .home-event__date {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
    min-width: 3.2rem;
    line-height: 1.1;
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .home-event__date strong { font-size: 2rem; letter-spacing: -0.03em; color: var(--accent); margin-block: 0.05em; }
  .home-event h3 { margin: 0; font-size: var(--step-1); }
  .home-event__when { margin: 0.3rem 0 0; color: var(--muted); font-size: 0.9375rem; }
  .home-event__links { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1.1rem; margin: 0.9rem 0 0; }
  .home-events__none { margin: 1rem 0 0; color: var(--muted); }
  .events__sub { margin-block: 1.25rem 0; font-size: 0.9375rem; }
</style>
